@using MeetupOrganiser.Core.Entities
@using MeetupOrganiser.Core.Services
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Core.DTOs
@using MeetupOrganiser.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IPptxGeneratorService PptxService
@inject ISocialImageGeneratorService SocialImageService
@inject ISocialMediaService SocialMediaService
@inject IMeetupService MeetupService
@inject ISettingsService SettingsService
@inject ILogger<EventAssets> Logger
@inject IJSRuntime JS

<div class="event-assets-page">
    @if (statusMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (selectedEvent == null)
    {
        @if (statusMessage == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-secondary">Loading event assets...</p>
            </div>
        }
    }
    else
    {
        <div class="row g-4">
            <!-- Left Column: Asset Previews and Downloads -->
            <div class="col-lg-6">
                <!-- Social Image Preview Card -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 asset-heading">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-image me-2 text-primary"></i>1280x720 Social Card Preview
                        </h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="RefreshImagePreviewAsync" disabled="@isGeneratingImage">
                            @if (isGeneratingImage)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Rendering...</span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                <span>Refresh</span>
                            }
                        </button>
                    </div>

                    <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden shadow-sm mb-3 position-relative">
                        @if (previewImageBase64 != null)
                        {
                            <img src="data:image/png;base64,@previewImageBase64" alt="Social card preview" class="img-fluid object-fit-contain" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center text-white-50">
                                <span class="spinner-border text-light me-2"></span> Generating 1280x720 PNG card...
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/api/events/@selectedEvent.Id/social-image" target="_blank" class="btn btn-primary flex-fill">
                            <i class="bi bi-download me-1"></i> Download Social PNG
                        </a>
                        <a href="/api/events/@selectedEvent.Id/pptx" target="_blank" class="btn btn-outline-primary flex-fill">
                            <i class="bi bi-file-earmark-slides me-1"></i> Download PPTX Deck
                        </a>
                    </div>
                </div>

                <!-- Meetup.com Event Content Card -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 asset-heading">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-calendar-event me-2 text-danger"></i>Meetup.com Publication
                        </h5>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="PublishToMeetupAsync" disabled="@isPublishingMeetup">
                            @if (isPublishingMeetup)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Publishing...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill me-1"></i>
                                <span>Publish to Meetup</span>
                            }
                        </button>
                    </div>
                    <p class="text-secondary small mb-2">
                        Copy the title and description into their matching fields on Meetup.com, or publish the event directly.
                    </p>
                    @if (meetupManualUrl is not null)
                    {
                        <p><a href="@meetupManualUrl" target="_blank" rel="noopener noreferrer">Open Meetup target <span class="visually-hidden">(opens in a new tab)</span></a></p>
                    }
                    <div class="border rounded p-3 mb-3">
                        <h6>Use the Meetup website (no API required)</h6>
                        <p class="small">Prepare the edited content below, then open the Meetup Organiser extension on this tab to capture it.
                            Open your group's create form or the existing event's edit form and use the extension again to fill supported fields.
                            Review every field and save/publish on Meetup yourself. Unsupported fields are listed as manual steps.</p>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="PrepareWebsiteHandoff" disabled="@(isPreparingWebsite || isGeneratingImage || previewImageBase64 is null)">
                            @(string.IsNullOrWhiteSpace(selectedEvent.MeetupEventUrl) ? "Prepare new event for Meetup" : "Prepare update for Meetup")
                        </button>
                        @if (websiteHandoffJson is not null)
                        {
                            <textarea id="meetup-organiser-handoff" hidden readonly>@websiteHandoffJson</textarea>
                            <p class="small mt-2 mb-0" role="status">Prepared for 30 minutes. Capture using the extension before changing tabs. This has not saved or published anything.</p>
                        }
                        <details class="mt-3">
                            <summary>I have saved or published this event on Meetup</summary>
                            <p class="small mt-2">Record your own confirmation, not a platform-verified result. Marking Published removes this date from new CFP bookings. Recording a draft will set this local event to Draft.</p>
                            <label for="meetup-completed-url" class="form-label small">Actual Meetup event URL</label>
                            <input id="meetup-completed-url" class="form-control form-control-sm" @bind="websiteCompletedUrl" placeholder="https://www.meetup.com/group/events/123/" />
                            <label for="meetup-completed-status" class="form-label small mt-2">What did you save on Meetup?</label>
                            <select id="meetup-completed-status" class="form-select form-select-sm" @bind="websiteCompletedStatus">
                                <option value="@EventStatus.Draft">Saved draft</option>
                                <option value="@EventStatus.Published">Published event</option>
                            </select>
                            <label class="small d-block my-2"><input type="checkbox" @bind="websiteOutcomeConfirmed" /> I checked the Meetup event and confirm this URL and status.</label>
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RecordWebsiteOutcomeAsync" disabled="@(!websiteOutcomeConfirmed || recordingWebsiteOutcome)">Record my confirmation</button>
                        </details>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="meetup-title">Meetup.com Title</label>
                        <div class="input-group">
                            <input id="meetup-title" type="text" class="form-control" @bind="meetupTitle" @bind:after="InvalidateWebsiteHandoff" />
                            <button type="button" class="btn btn-outline-primary" @onclick="CopyMeetupTitleAsync">
                                <i class="bi bi-clipboard me-1"></i> Copy Title
                            </button>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold" for="meetup-description">Meetup.com Description</label>
                        <MeetupMarkdownEditor Id="meetup-description" @bind-Value="meetupMarkdownDescription" @bind-Value:after="InvalidateWebsiteHandoff" />
                        <small class="text-secondary">Preview edits are used by Copy Description and Prepare for Meetup, not saved to the event. Direct API publication and extension API loading use saved event/template content.</small>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-secondary border">Markdown Formatted</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CopyMeetupDescriptionAsync">
                            <i class="bi bi-clipboard me-1"></i> Copy Description
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Multi-Channel Social Activation -->
            <div class="col-lg-6">
                <!-- LinkedIn Activation -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2 asset-heading">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-linkedin me-2 text-primary"></i>LinkedIn
                        </h5>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-primary" @onclick="PublishToLinkedInAsync" disabled="@isPublishingLinkedIn">
                                <i class="bi bi-send me-1"></i> Post via API
                            </button>
                            @if (!string.IsNullOrWhiteSpace(linkedInIntentUrl))
                            {
                                <a href="@linkedInIntentUrl" target="_blank" class="btn btn-outline-primary" title="Open LinkedIn Share Fallback">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Web Share
                                </a>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <textarea class="form-control small" rows="4" @bind="linkedInText"></textarea>
                    </div>
                    <div class="form-check mb-2">
                        <input id="linkedin-attach-image" type="checkbox" class="form-check-input" @bind="attachLinkedInImage" />
                        <label class="form-check-label" for="linkedin-attach-image">Attach social card image</label>
                    </div>
                    <div class="d-flex justify-content-between align-items-center asset-meta">
                        <small class="text-muted">Includes event title, speaker tags, and registration link.</small>
                        <span class="badge bg-light text-secondary border">LinkedIn Posts API</span>
                    </div>
                </div>

                <!-- X / Twitter Activation -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2 asset-heading">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-twitter-x me-2 text-dark"></i>X (Twitter)
                        </h5>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-dark" @onclick="PublishToTwitterAsync" disabled="@isPublishingTwitter">
                                <i class="bi bi-send me-1"></i> @(attachTwitterImage ? "Post with Image" : "Post Link Only")
                            </button>
                            @if (!string.IsNullOrWhiteSpace(twitterIntentUrl))
                            {
                                <a href="@twitterIntentUrl" target="_blank" class="btn btn-outline-dark" title="Open pre-filled Tweet">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Web Intent
                                </a>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <textarea class="form-control small" rows="3" @bind="twitterText"></textarea>
                    </div>
                    <div class="form-check mb-2">
                        <input id="twitter-attach-image" type="checkbox" class="form-check-input" @bind="attachTwitterImage" />
                        <label class="form-check-label" for="twitter-attach-image">Attach social card image</label>
                    </div>
                    <div class="d-flex justify-content-between align-items-center asset-meta">
                        <small class="text-muted">Character count: @(twitterText?.Length ?? 0) / 280. Web Intent does not attach the image.</small>
                        <span class="badge bg-light text-secondary border">X API + Web Intent</span>
                    </div>
                </div>

                <!-- BlueSky Activation -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2 asset-heading">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-cloud me-2 text-info"></i>BlueSky (AT Protocol)
                        </h5>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-info text-white" @onclick="PublishToBlueSkyAsync" disabled="@isPublishingBlueSky">
                                <i class="bi bi-send me-1"></i> @(attachBlueSkyImage ? "Post with Image" : "Post Link Only")
                            </button>
                            <a href="@BlueSkyIntentUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info" title="Open Bluesky compose with this text pre-filled">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Web Intent
                            </a>
                        </div>
                    </div>
                    <div class="mb-2">
                        <textarea class="form-control small" rows="3" @bind="blueSkyText" @bind:event="oninput"></textarea>
                    </div>
                    <div class="form-check mb-2">
                        <input id="bluesky-attach-image" type="checkbox" class="form-check-input" @bind="attachBlueSkyImage" />
                        <label class="form-check-label" for="bluesky-attach-image">Attach social card image</label>
                    </div>
                    <div class="d-flex justify-content-between align-items-center asset-meta">
                        <small class="text-muted">Character count: @(blueSkyText?.Length ?? 0) / 300. The web intent can't attach the image; download the PNG and add it manually.</small>
                        <span class="badge bg-light text-secondary border">AT Protocol</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .event-assets-page .asset-heading { gap: .75rem; }
    .event-assets-page .asset-heading h5 { min-width: 0; }
    .event-assets-page .asset-heading .btn-group { flex-wrap: wrap; justify-content: flex-end; }
    .event-assets-page .asset-meta { gap: .75rem; }
    .event-assets-page .input-group { min-width: 0; }
    .event-assets-page .input-group > .form-control { min-width: 0; }
    @@media (max-width: 575.98px) {
        .event-assets-page .card { padding: 1rem !important; }
        .event-assets-page .asset-heading { align-items: flex-start !important; flex-wrap: wrap; }
        .event-assets-page .asset-heading h5 { flex: 1 1 100%; }
        .event-assets-page .asset-heading > .btn,
        .event-assets-page .asset-heading > .btn-group { width: 100%; }
        .event-assets-page .asset-heading > .btn-group { display: flex; }
        .event-assets-page .asset-heading > .btn-group > .btn { flex: 1 1 auto; white-space: normal; }
        .event-assets-page .asset-meta { align-items: flex-start !important; flex-wrap: wrap; }
        .event-assets-page .asset-meta > * { max-width: 100%; overflow-wrap: anywhere; }
        .event-assets-page .card .d-flex.gap-2 > .btn { min-width: 0; }
        .event-assets-page .input-group { flex-wrap: wrap; gap: .5rem; }
        .event-assets-page .input-group > .form-control { flex: 1 1 100%; width: 100%; border-radius: var(--bs-border-radius) !important; }
        .event-assets-page .input-group > .btn { flex: 1 1 100%; width: 100%; border-radius: var(--bs-border-radius) !important; }
        .event-assets-page .ratio { max-width: 100%; }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public Guid EventId { get; set; }

    private MeetupEvent? selectedEvent;
    private Guid loadedEventId;

    private string? previewImageBase64;
    private string meetupTitle = string.Empty;
    private string? meetupMarkdownDescription;
    private string? linkedInText;
    private bool attachLinkedInImage = true;
    private string? linkedInIntentUrl;
    private string? twitterText;
    private bool attachTwitterImage = true;
    private string? twitterIntentUrl;
    private string? blueSkyText;
    private bool attachBlueSkyImage = true;
    private string BlueSkyIntentUrl => $"https://bsky.app/intent/compose?text={Uri.EscapeDataString(blueSkyText ?? string.Empty)}";

    private bool isGeneratingImage;
    private bool isPublishingMeetup;
    private bool isPublishingLinkedIn;
    private bool isPublishingTwitter;
    private bool isPublishingBlueSky;

    private string? statusMessage;
    private string? meetupManualUrl;
    private string? websiteHandoffJson;
    private bool isPreparingWebsite;
    private long websiteRevision;
    private string websiteCompletedUrl = string.Empty;
    private EventStatus websiteCompletedStatus = EventStatus.Draft;
    private bool websiteOutcomeConfirmed, recordingWebsiteOutcome;
    private bool isError;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedEventId == EventId) return;
        loadedEventId = EventId;
        selectedEvent = null;
        meetupManualUrl = null;
        InvalidateWebsiteHandoff();
        websiteCompletedUrl = string.Empty;
        websiteOutcomeConfirmed = false;
        previewImageBase64 = null;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            selectedEvent = await dbContext.MeetupEvents
                .Include(e => e.MeetupGroup).ThenInclude(g => g!.Sponsors)
                .Include(e => e.Sessions).ThenInclude(s => s.Speaker)
                .AsSplitQuery()
                .FirstOrDefaultAsync(e => e.Id == EventId);

            if (selectedEvent == null)
            {
                statusMessage = "That event could not be found.";
                isError = true;
                return;
            }

            await LoadEventDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Social & Slides.");
            statusMessage = "Unable to load event assets. Please reload and try again. The error has been logged.";
            isError = true;
        }
    }

    private string? websiteBioPreference;

    private async Task LoadEventDataAsync()
    {
        try
        {
            if (selectedEvent == null) return;

            meetupTitle = selectedEvent.Title;
            var eventGroup = selectedEvent.MeetupGroup;
            var bioPreference = !string.IsNullOrWhiteSpace(eventGroup?.BioPreference) ? eventGroup.BioPreference : await SettingsService.GetSettingAsync(SpeakerBio.SettingKey);
            websiteBioPreference = bioPreference;
            var template = (!string.IsNullOrWhiteSpace(eventGroup?.MeetupDescriptionTemplate) ? eventGroup.MeetupDescriptionTemplate : null)
                ?? await SettingsService.GetSettingAsync(MeetupDescriptionTemplate.SettingKey) ?? MeetupDescriptionTemplate.Default;
            await using var templateDb = await DbContextFactory.CreateDbContextAsync();
            var sections = await templateDb.TemplateSections.AsNoTracking().ToListAsync();
            meetupMarkdownDescription = MeetupService.GenerateMeetupDescription(selectedEvent, bioPreference, template, sections);
            linkedInText = SocialMediaService.GeneratePlatformPostText(selectedEvent, "LinkedIn");
            twitterText = SocialMediaService.GeneratePlatformPostText(selectedEvent, "Twitter");
            blueSkyText = SocialMediaService.GeneratePlatformPostText(selectedEvent, "BlueSky");
            twitterIntentUrl = SocialMediaService.GetPlatformWebIntentUrl(selectedEvent, "Twitter");
            linkedInIntentUrl = SocialMediaService.GetPlatformWebIntentUrl(selectedEvent, "LinkedIn");

            await GenerateImagePreviewAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to prepare assets for event {EventId}.", EventId);
            statusMessage = "Unable to prepare this event's assets. The error has been logged.";
            isError = true;
        }
    }

    private Task CopyMeetupTitleAsync() => CopyMeetupTextAsync(meetupTitle, "title");

    private void InvalidateWebsiteHandoff()
    {
        websiteHandoffJson = null;
        websiteRevision++;
    }

    private async Task PrepareWebsiteHandoff()
    {
        if (selectedEvent is null || isPreparingWebsite) return;
        InvalidateWebsiteHandoff();
        isPreparingWebsite = true;
        var revision = websiteRevision;
        var preparingEvent = selectedEvent;
        var preparingImage = previewImageBase64;
        try
        {
            var payload = MeetupWebsite.Prepare(preparingEvent, meetupTitle, meetupMarkdownDescription, preparingImage ?? string.Empty, websiteBioPreference);
            payload = await MeetupOrganiser.Infrastructure.Services.MeetupWebsiteSpeakerPhoto.AttachAsync(payload, preparingEvent);
            if (revision != websiteRevision || selectedEvent != preparingEvent || previewImageBase64 != preparingImage)
            {
                statusMessage = "The preview changed while preparing website content. Prepare it again to capture your latest edits.";
                isError = true;
                return;
            }
            websiteHandoffJson = System.Text.Json.JsonSerializer.Serialize(payload, System.Text.Json.JsonSerializerOptions.Web);
            statusMessage = "Website content prepared. Capture it with the Meetup Organiser extension. No event has been saved or published.";
            meetupManualUrl = payload.EventUrl ?? $"https://www.meetup.com/{payload.GroupSlug}/";
            isError = false;
        }
        catch (ArgumentException ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to prepare Meetup website content for {EventId}.", EventId);
            statusMessage = "Unable to prepare website content. Your event details have not been changed. Reload and try again.";
            isError = true;
        }
        finally
        {
            isPreparingWebsite = false;
        }
    }

    private async Task RecordWebsiteOutcomeAsync()
    {
        if (!websiteOutcomeConfirmed || recordingWebsiteOutcome) return;
        recordingWebsiteOutcome = true;
        try
        {
            if (websiteCompletedStatus is not (EventStatus.Draft or EventStatus.Published))
                throw new ArgumentException("Choose Saved draft or Published event.");
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var stored = await db.MeetupEvents
                .Include(e => e.MeetupGroup).ThenInclude(g => g!.Sponsors)
                .Include(e => e.Sessions).ThenInclude(s => s.Speaker)
                .AsSplitQuery().SingleAsync(e => e.Id == EventId);
            var (url, id) = MeetupWebsite.ValidateEventUrl(websiteCompletedUrl, stored.MeetupGroup?.MeetupUrlName ?? "", stored.MeetupEventUrl);
            if (!string.IsNullOrWhiteSpace(stored.MeetupEventId) && stored.MeetupEventId != id)
                throw new ArgumentException("This local event is already linked to a different Meetup event.");
            stored.MeetupEventUrl = url;
            stored.MeetupEventId = id;
            stored.Status = websiteCompletedStatus;
            await db.SaveChangesAsync();
            selectedEvent = stored;
            websiteHandoffJson = null;
            websiteOutcomeConfirmed = false;
            statusMessage = $"Recorded your confirmation: {websiteCompletedStatus}. This result was reported by you, not verified through Meetup.";
            meetupManualUrl = url;
            isError = false;
        }
        catch (ArgumentException ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not record organiser-reported Meetup outcome for event {EventId}.", EventId);
            statusMessage = "Unable to record your confirmation. Your Meetup event has not been changed; retry recording the result here.";
            isError = true;
        }
        finally { recordingWebsiteOutcome = false; }
    }

    private async Task CopyMeetupDescriptionAsync()
    {
        try
        {
            var format = await JS.InvokeAsync<string>("meetupOrganiser.copyMarkdown",
                meetupMarkdownDescription, MeetupMarkdown.ToHtml(meetupMarkdownDescription));
            statusMessage = format == "html" ? "Formatted Meetup description copied to the clipboard."
                : "Meetup description copied as Markdown text; formatted clipboard access is unavailable.";
            isError = false;
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Failed to copy Meetup description for event {EventId}.", EventId);
            statusMessage = "Unable to copy the Meetup description. Check your browser's clipboard permissions.";
            isError = true;
        }
    }

    private async Task CopyMeetupTextAsync(string? text, string field)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text ?? string.Empty);
            statusMessage = $"Meetup {field} copied to the clipboard.";
            isError = false;
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Failed to copy Meetup {Field} for event {EventId}.", field, EventId);
            statusMessage = $"Unable to copy the Meetup {field}. Check your browser's clipboard permissions.";
            isError = true;
        }
    }

    private async Task GenerateImagePreviewAsync()
    {
        if (selectedEvent == null) return;

        try
        {
            isGeneratingImage = true;
            var imageBytes = await SocialImageService.GenerateSocialCardAsync(selectedEvent);
            previewImageBase64 = Convert.ToBase64String(imageBytes);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to render social image card.");
            statusMessage = $"Error rendering social card: {ex.Message}";
            isError = true;
        }
        finally
        {
            isGeneratingImage = false;
        }
    }

    private async Task RefreshImagePreviewAsync()
    {
        if (selectedEvent == null) return;

        try
        {
            isGeneratingImage = true;
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var latest = await dbContext.MeetupEvents
                .Include(e => e.MeetupGroup).ThenInclude(g => g!.Sponsors)
                .Include(e => e.Sessions).ThenInclude(s => s.Speaker)
                .AsSplitQuery()
                .FirstOrDefaultAsync(e => e.Id == EventId);
            if (latest != null) selectedEvent = latest;

            var imageBytes = await SocialImageService.GenerateSocialCardAsync(selectedEvent);
            previewImageBase64 = Convert.ToBase64String(imageBytes);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh social image card.");
            statusMessage = $"Error rendering social card: {ex.Message}";
            isError = true;
        }
        finally
        {
            isGeneratingImage = false;
        }
    }

    private async Task PublishToMeetupAsync()
    {
        if (selectedEvent == null) return;
        try
        {
            isPublishingMeetup = true;
            meetupManualUrl = null;
            var result = await MeetupService.CreateEventAsync(selectedEvent);
            if (result.RequiresManualAction)
            {
                statusMessage = "No event has been published. Meetup API access is not configured. Open your Meetup group, create the event, and copy the title and description below. Download the social PNG to upload as the event image.";
                meetupManualUrl = result.EventUrl;
                isError = false;
            }
            else if (result.Success)
            {
                statusMessage = $"Published to Meetup! Event URL: {result.EventUrl}";
                isError = false;
            }
            else
            {
                statusMessage = $"Meetup publication note: {result.ErrorMessage}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to publish Meetup event {EventId}.", EventId);
            statusMessage = "Unable to confirm Meetup publication. Check your Meetup group before trying again to avoid creating a duplicate event.";
            isError = true;
        }
        finally
        {
            isPublishingMeetup = false;
        }
    }

    private async Task PublishToLinkedInAsync()
    {
        if (selectedEvent == null) return;
        try
        {
            isPublishingLinkedIn = true;
            byte[]? imageBytes = attachLinkedInImage && previewImageBase64 != null ? Convert.FromBase64String(previewImageBase64) : null;
            var result = await SocialMediaService.PostToLinkedInAsync(linkedInText ?? string.Empty, imageBytes);
            statusMessage = result.Success
                ? "Successfully published to LinkedIn!"
                : $"LinkedIn note: {result.ErrorMessage}. You can use the 'Web Share' button.";
            isError = !result.Success;
        }
        finally
        {
            isPublishingLinkedIn = false;
        }
    }

