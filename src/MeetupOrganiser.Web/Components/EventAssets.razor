    private async Task PublishToBlueSkyAsync()
    {
        if (selectedEvent == null) return;
        try
        {
            isPublishingBlueSky = true;
            byte[]? imageBytes = null;
            if (attachBlueSkyImage && previewImageBase64 != null)
            {
                imageBytes = Convert.FromBase64String(previewImageBase64);
