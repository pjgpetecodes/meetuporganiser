@if (ShowLegend)
{
    <p class="small text-secondary my-2">
        <span class="public-holiday-badge" aria-hidden="true">PH</span>
        Public holiday (England and Wales). Holiday dates remain selectable.
    </p>
}
@if (Calendar is null)
{
    <p class="small text-secondary" role="status">Loading public holiday information...</p>
}
else if (!Calendar.IsAvailable)
{
    <p class="small text-warning-emphasis" role="status">Public holiday information is unavailable. Dates can still be selected; check bank holidays separately.</p>
}
else if (UnpublishedYears.Length > 0)
{
    <p class="small text-warning-emphasis" role="status">Public holiday information is not published for @string.Join(", ", UnpublishedYears). Dates can still be selected; check bank holidays separately.</p>
}

@code {
    [Parameter] public BankHolidayCalendar? Calendar { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public IEnumerable<int> Years { get; set; } = [];
    private int[] UnpublishedYears => Years.Distinct().Where(year => Calendar?.CoversYear(year) != true).Order().ToArray();
}
