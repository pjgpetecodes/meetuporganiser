@page "/settings"
@attribute [Authorize]
@using MeetupOrganiser.Core.DTOs
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Core.Services
@inject ISettingsService SettingsService
@inject ILogger<Settings> Logger
@inject NavigationManager NavManager

<PageTitle>API Integrations &amp; Settings - Meetup Organiser</PageTitle>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-sliders text-primary me-2"></i>API Integrations &amp; Settings
            </h1>
            <p class="text-secondary mb-0">Configure API credentials, tokens, and endpoints for external platform integrations.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="SaveAllAsync" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span>Save All Changes</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Loading integration settings...</p>
        </div>
    }
    else
    {
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "general" ? "active" : "")" @onclick='() => activeTab = "general"'>
                    <i class="bi bi-gear me-1"></i> General
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "api" ? "active" : "")" @onclick='() => activeTab = "api"'>
                    <i class="bi bi-plug me-1"></i> API Integrations
                </button>
            </li>
        </ul>

        <div class="@(activeTab == "general" ? "" : "d-none")">
        <div class="row g-4">
            <!-- Speaker Bios Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-person-lines-fill text-info fs-4"></i>
                        <h5 class="fw-bold mb-0">Speaker Bios</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Choose which bio is published in Meetup descriptions.</p>
                        <select class="form-select" @bind="model.BioPreference">
                            <option value="ThirdPerson">Third-person bio (recommended)</option>
                            <option value="Original">Original bio as written</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Meetup Description Template Card -->
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-file-text text-primary fs-4"></i>
                        <h5 class="fw-bold mb-0">Meetup Description Template</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Used to build the event description when you pick a talk, and when publishing to Meetup. Write plain text or Markdown and insert placeholders such as <code>{{EventTitle}}</code>; they are replaced for each event. Placeholders that are empty are removed.</p>
                        <textarea class="form-control font-monospace small mb-2" rows="18" @bind="model.DescriptionTemplate"></textarea>
                        <button type="button" class="btn btn-sm btn-outline-secondary mb-3" @onclick="ResetTemplate">Reset to default</button>
                        <div class="small fw-semibold mb-1">Available placeholders</div>
                        <ul class="small text-muted mb-0 column-count-2">
                            @foreach (var (name, description) in MeetupDescriptionTemplate.Placeholders)
                            {
                                <li><code>@("{{" + name + "}}")</code> &ndash; @description</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

        </div>
        </div>

        <div class="@(activeTab == "api" ? "" : "d-none")">
    <!-- Storage explanation banner -->
    <div class="card border-0 shadow-sm bg-light mb-4">
        <div class="card-body p-3 d-flex align-items-start gap-3">
            <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
            <div>
                <h6 class="fw-bold mb-1">Persistent &amp; Secure Configuration</h6>
                <p class="small text-muted mb-0">
                    Keys and credentials saved here are stored in your SQL Database. When left blank, services seamlessly fall back to values defined in <code>appsettings.json</code>, Azure App Service environment variables, or Azure Key Vault.
                    When credentials are not supplied, the app automatically operates in <strong>Fallback Mode</strong> (allowing one-click web intent sharing and pre-filled copy-paste templates).
                </p>
            </div>
        </div>
    </div>

            <div class="tab-pane-content">
                <div class="accordion shadow-sm" id="integrationsAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(openIntegration == "bluesky" ? "" : "collapsed")" type="button" @onclick='() => ToggleIntegration("bluesky")'>
                                <i class="bi bi-bluesky text-info fs-4 me-3"></i>
                                <span class="fw-bold me-auto">BlueSky</span>
                                <span class="me-3">
            @if (!string.IsNullOrWhiteSpace(model.BlueSkyHandle) && !string.IsNullOrWhiteSpace(model.BlueSkyAppPassword))
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i> Connected
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                    <i class="bi bi-arrow-up-right me-1"></i> Web Intent Fallback
                </span>
            }
                                </span>
                            </button>
                        </h2>
                        @if (openIntegration == "bluesky")
                        {
                            <div class="accordion-collapse show">
                                <div class="accordion-body">
            <p class="small text-muted mb-3">Posts announcement updates and uploads 1280x720 social card blobs via the AT Protocol.</p>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Handle</label>
                <input type="text" class="form-control" placeholder="e.g. dotnetnotts.bsky.social"
                       @bind="model.BlueSkyHandle" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold small">App Password</label>
                <div class="input-group">
                    <input type="@(showPasswords.Contains("BlueSky") ? "text" : "password")"
                           class="form-control" placeholder="xxxx-xxxx-xxxx-xxxx"
                           @bind="model.BlueSkyAppPassword" />
                    <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("BlueSky")'>
                        <i class="bi @(showPasswords.Contains("BlueSky") ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <div class="form-text">Generate in BlueSky Settings &rarr; Privacy &amp; Security &rarr; App Passwords.</div>
            </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(openIntegration == "zoom" ? "" : "collapsed")" type="button" @onclick='() => ToggleIntegration("zoom")'>
                                <i class="bi bi-camera-video text-primary fs-4 me-3"></i>
                                <span class="fw-bold me-auto">Zoom Meetings</span>
                                <span class="me-3">
            @if (!string.IsNullOrWhiteSpace(model.ZoomAccountId) && !string.IsNullOrWhiteSpace(model.ZoomClientId) && !string.IsNullOrWhiteSpace(model.ZoomClientSecret))
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i> Connected
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                    <i class="bi bi-link me-1"></i> Safe Demo Link Mode
                </span>
            }
                                </span>
                            </button>
                        </h2>
                        @if (openIntegration == "zoom")
                        {
                            <div class="accordion-collapse show">
                                <div class="accordion-body">
            <p class="small text-muted mb-3">Creates Zoom meetings with Passcodes and Join URLs using Zoom Server-to-Server OAuth. On a free account, set a fixed meeting URL instead.</p>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Default Meeting URL (no API needed)</label>
                <input type="text" class="form-control" placeholder="https://us05web.zoom.us/j/..."
                       @bind="model.ZoomDefaultMeetingUrl" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Default Passcode</label>
                <input type="text" class="form-control" placeholder="Optional"
                       @bind="model.ZoomDefaultPasscode" />
                <div class="form-text">Used when the API credentials below are blank.</div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Account ID</label>
                <input type="text" class="form-control" placeholder="Zoom Account ID"
                       @bind="model.ZoomAccountId" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small">OAuth Client ID</label>
                <input type="text" class="form-control" placeholder="Client ID"
                       @bind="model.ZoomClientId" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold small">OAuth Client Secret</label>
                <div class="input-group">
                    <input type="@(showPasswords.Contains("Zoom") ? "text" : "password")"
                           class="form-control" placeholder="Client Secret"
                           @bind="model.ZoomClientSecret" />
                    <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("Zoom")'>
                        <i class="bi @(showPasswords.Contains("Zoom") ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <div class="form-text">Created in Zoom App Marketplace &rarr; Server-to-Server OAuth App.</div>
            </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(openIntegration == "meetup" ? "" : "collapsed")" type="button" @onclick='() => ToggleIntegration("meetup")'>
                                <i class="bi bi-calendar-check text-danger fs-4 me-3"></i>
                                <span class="fw-bold me-auto">Meetup.com</span>
                                <span class="me-3">
            @if (model.MeetupOAuthConnected || !string.IsNullOrWhiteSpace(model.MeetupApiKey))
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i> API Mode
                </span>
            }
            else
            {
                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                    <i class="bi bi-clipboard me-1"></i> Markdown Export Mode
                </span>
            }
                                </span>
                            </button>
                        </h2>
                        @if (openIntegration == "meetup")
                        {
                            <div class="accordion-collapse show">
                                <div class="accordion-body">
            <p class="small text-muted mb-3">Connect with Meetup OAuth to publish events and import past events for your group. Each Meetup Group under <em>Meetup Groups</em> can also specify its own URL slug and optional access-token override.</p>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Default Group URL Name (Fallback)</label>
                <input type="text" class="form-control" placeholder="e.g. dotnetnotts"
                       @bind="model.MeetupUrlname" />
                <div class="form-text">Default slug used when a group doesn't have an explicit slug defined.</div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small">OAuth Client ID</label>
                <input type="text" class="form-control" placeholder="Meetup OAuth client ID"
                       @bind="model.MeetupClientId" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small">OAuth Client Secret</label>
                <div class="input-group">
                    <input type="@(showPasswords.Contains("MeetupClientSecret") ? "text" : "password")"
                           class="form-control" placeholder="Meetup OAuth client secret"
                           @bind="model.MeetupClientSecret" />
                    <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("MeetupClientSecret")'>
                        <i class="bi @(showPasswords.Contains("MeetupClientSecret") ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small">OAuth Redirect URL</label>
                <input type="url" class="form-control"
                       @bind="model.MeetupRedirectUri" />
                <div class="form-text">Register this exact URL in your Meetup OAuth client. For F5, use <code>http://localhost:5107/integrations/meetup/callback</code>.</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(model.MeetupClientId) && !string.IsNullOrWhiteSpace(model.MeetupClientSecret))
            {
                <a class="btn btn-outline-danger mb-3" href="/integrations/meetup/connect">
                    <i class="bi bi-link-45deg me-1"></i> @(model.MeetupOAuthConnected ? "Reconnect Meetup" : "Connect Meetup")
                </a>
                <div class="form-text mb-3">Save your OAuth client ID, secret, and redirect URL before connecting.</div>
            }
            <div class="mb-2">
                <label class="form-label fw-semibold small">Legacy Access Token (Optional)</label>
                <div class="input-group">
                    <input type="@(showPasswords.Contains("Meetup") ? "text" : "password")"
                           class="form-control" placeholder="Meetup OAuth Access Token"
                           @bind="model.MeetupApiKey" />
                    <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("Meetup")'>
                        <i class="bi @(showPasswords.Contains("Meetup") ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <div class="form-text">Optional fallback for manually supplied access tokens. OAuth connection above is preferred.</div>
            </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(openIntegration == "sessionize" ? "" : "collapsed")" type="button" @onclick='() => ToggleIntegration("sessionize")'>
                                <i class="bi bi-mic text-warning fs-4 me-3"></i>
                                <span class="fw-bold me-auto">Sessionize</span>
                                <span class="me-3">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                <i class="bi bi-globe me-1"></i> Public REST API
            </span>
                                </span>
                            </button>
                        </h2>
                        @if (openIntegration == "sessionize")
                        {
                            <div class="accordion-collapse show">
                                <div class="accordion-body">
            <p class="small text-muted mb-3">Pulls speakers, bios, headshot photos, and talk descriptions directly into event sessions without authentication.</p>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Default Event ID / Endpoint</label>
                <input type="text" class="form-control" placeholder="e.g. 7q8z9x1y or full view endpoint URL"
                       @bind="model.SessionizeDefaultEventId" />
                <div class="form-text">Found in Sessionize &rarr; API / Embed &rarr; View Speakers / Sessions.</div>
            </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(openIntegration == "linkedin" ? "" : "collapsed")" type="button" @onclick='() => ToggleIntegration("linkedin")'>
                                <i class="bi bi-linkedin text-primary fs-4 me-3"></i>
                                <span class="fw-bold me-auto">LinkedIn</span>
                                <span class="me-3">
            @if (!string.IsNullOrWhiteSpace(model.LinkedInAccessToken))
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i> API Mode
                </span>
            }
            else
            {
                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                    <i class="bi bi-share me-1"></i> Web Share Fallback
                </span>
            }
                                </span>
                            </button>
                        </h2>
                        @if (openIntegration == "linkedin")
                        {
                            <div class="accordion-collapse show">
                                <div class="accordion-body">
            <p class="small text-muted mb-3">Shares formatted event announcements to LinkedIn profiles or organizational pages.</p>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small">Client ID</label>
                    <input type="text" class="form-control" placeholder="Client ID"
                           @bind="model.LinkedInClientId" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small">Author URN</label>
                    <input type="text" class="form-control" placeholder="urn:li:organization:... or person:..."
