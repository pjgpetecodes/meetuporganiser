@page "/settings"
@attribute [Authorize]
@using MeetupOrganiser.Core.DTOs
@using MeetupOrganiser.Core.Interfaces
@inject ISettingsService SettingsService
@inject ILogger<Settings> Logger

<PageTitle>API Integrations &amp; Settings - Meetup Organiser</PageTitle>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-sliders text-primary me-2"></i>API Integrations &amp; Settings
            </h1>
            <p class="text-secondary mb-0">Configure API credentials, tokens, and endpoints for external platform integrations.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="SaveAllAsync" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span>Save All Changes</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Storage explanation banner -->
    <div class="card border-0 shadow-sm bg-light mb-4">
        <div class="card-body p-3 d-flex align-items-start gap-3">
            <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
            <div>
                <h6 class="fw-bold mb-1">Persistent &amp; Secure Configuration</h6>
                <p class="small text-muted mb-0">
                    Keys and credentials saved here are stored in your SQL Database. When left blank, services seamlessly fall back to values defined in <code>appsettings.json</code>, Azure App Service environment variables, or Azure Key Vault.
                    When credentials are not supplied, the app automatically operates in <strong>Fallback Mode</strong> (allowing one-click web intent sharing and pre-filled copy-paste templates).
                </p>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Loading integration settings...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- BlueSky Integration Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-cloud-sun text-info fs-4"></i>
                            <h5 class="fw-bold mb-0">BlueSky</h5>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.BlueSkyHandle) && !string.IsNullOrWhiteSpace(model.BlueSkyAppPassword))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> Connected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                <i class="bi bi-arrow-up-right me-1"></i> Web Intent Fallback
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Posts announcement updates and uploads 1280x720 social card blobs via the AT Protocol.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Handle</label>
                            <input type="text" class="form-control" placeholder="e.g. dotnetnotts.bsky.social"
                                   @bind="model.BlueSkyHandle" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small">App Password</label>
                            <div class="input-group">
                                <input type="@(showPasswords.Contains("BlueSky") ? "text" : "password")"
                                       class="form-control" placeholder="xxxx-xxxx-xxxx-xxxx"
                                       @bind="model.BlueSkyAppPassword" />
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("BlueSky")'>
                                    <i class="bi @(showPasswords.Contains("BlueSky") ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <div class="form-text">Generate in BlueSky Settings &rarr; Privacy &amp; Security &rarr; App Passwords.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Zoom Integration Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-camera-video text-primary fs-4"></i>
                            <h5 class="fw-bold mb-0">Zoom Meetings</h5>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.ZoomAccountId) && !string.IsNullOrWhiteSpace(model.ZoomClientId) && !string.IsNullOrWhiteSpace(model.ZoomClientSecret))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> Connected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                <i class="bi bi-link me-1"></i> Safe Demo Link Mode
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Creates Zoom meetings with Passcodes and Join URLs using Zoom Server-to-Server OAuth.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Account ID</label>
                            <input type="text" class="form-control" placeholder="Zoom Account ID"
                                   @bind="model.ZoomAccountId" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">OAuth Client ID</label>
                            <input type="text" class="form-control" placeholder="Client ID"
                                   @bind="model.ZoomClientId" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small">OAuth Client Secret</label>
                            <div class="input-group">
                                <input type="@(showPasswords.Contains("Zoom") ? "text" : "password")"
                                       class="form-control" placeholder="Client Secret"
                                       @bind="model.ZoomClientSecret" />
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("Zoom")'>
                                    <i class="bi @(showPasswords.Contains("Zoom") ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <div class="form-text">Created in Zoom App Marketplace &rarr; Server-to-Server OAuth App.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Meetup.com Integration Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-check text-danger fs-4"></i>
                            <h5 class="fw-bold mb-0">Meetup.com</h5>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.MeetupApiKey))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> API Mode
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                <i class="bi bi-clipboard me-1"></i> Markdown Export Mode
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Coordinates Meetup events, pre-formats rich descriptions, and links to your group's event creator.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Group URL Name</label>
                            <input type="text" class="form-control" placeholder="e.g. dotnetnotts"
                                   @bind="model.MeetupUrlname" />
                            <div class="form-text">The slug from your Meetup group URL (e.g. meetup.com/<strong>dotnetnotts</strong>).</div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small">API Key / OAuth Token (Optional)</label>
                            <div class="input-group">
                                <input type="@(showPasswords.Contains("Meetup") ? "text" : "password")"
                                       class="form-control" placeholder="Meetup OAuth Access Token"
                                       @bind="model.MeetupApiKey" />
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("Meetup")'>
                                    <i class="bi @(showPasswords.Contains("Meetup") ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <div class="form-text">If unconfigured, event descriptions are formatted with a 1-click clipboard copy.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sessionize Integration Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-mic text-warning fs-4"></i>
                            <h5 class="fw-bold mb-0">Sessionize</h5>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <i class="bi bi-globe me-1"></i> Public REST API
                        </span>
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Pulls speakers, bios, headshot photos, and talk descriptions directly into event sessions without authentication.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Default Event ID / Endpoint</label>
                            <input type="text" class="form-control" placeholder="e.g. 7q8z9x1y or full view endpoint URL"
                                   @bind="model.SessionizeDefaultEventId" />
                            <div class="form-text">Found in Sessionize &rarr; API / Embed &rarr; View Speakers / Sessions.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- LinkedIn Integration Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-linkedin text-primary fs-4"></i>
                            <h5 class="fw-bold mb-0">LinkedIn</h5>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.LinkedInAccessToken))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> API Mode
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                <i class="bi bi-share me-1"></i> Web Share Fallback
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Shares formatted event announcements to LinkedIn profiles or organizational pages.</p>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Client ID</label>
                                <input type="text" class="form-control" placeholder="Client ID"
                                       @bind="model.LinkedInClientId" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Author URN</label>
                                <input type="text" class="form-control" placeholder="urn:li:organization:... or person:..."
                                       @bind="model.LinkedInAuthorUrn" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Client Secret</label>
                            <div class="input-group">
                                <input type="@(showPasswords.Contains("LinkedInSecret") ? "text" : "password")"
                                       class="form-control" placeholder="Client Secret"
                                       @bind="model.LinkedInClientSecret" />
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("LinkedInSecret")'>
                                    <i class="bi @(showPasswords.Contains("LinkedInSecret") ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small">Access Token</label>
                            <div class="input-group">
                                <input type="@(showPasswords.Contains("LinkedInToken") ? "text" : "password")"
                                       class="form-control" placeholder="OAuth Access Token"
                                       @bind="model.LinkedInAccessToken" />
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("LinkedInToken")'>
                                    <i class="bi @(showPasswords.Contains("LinkedInToken") ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- X / Twitter Integration Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-twitter-x fs-4"></i>
                            <h5 class="fw-bold mb-0">X (Twitter)</h5>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.TwitterApiKey) && !string.IsNullOrWhiteSpace(model.TwitterAccessToken))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> API Mode
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Tweet Intent Fallback
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">Posts event teasers with speaker handles and hashtags, or opens pre-filled compose intents.</p>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">API / Consumer Key</label>
                                <input type="text" class="form-control" placeholder="API Key"
                                       @bind="model.TwitterApiKey" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Access Token</label>
                                <input type="text" class="form-control" placeholder="Access Token"
                                       @bind="model.TwitterAccessToken" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">API Secret</label>
                            <div class="input-group">
                                <input type="@(showPasswords.Contains("TwitterSecret") ? "text" : "password")"
                                       class="form-control" placeholder="API Secret"
                                       @bind="model.TwitterApiSecret" />
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("TwitterSecret")'>
                                    <i class="bi @(showPasswords.Contains("TwitterSecret") ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small">Access Token Secret</label>
                            <div class="input-group">
                                <input type="@(showPasswords.Contains("TwitterTokenSecret") ? "text" : "password")"
                                       class="form-control" placeholder="Access Token Secret"
                                       @bind="model.TwitterAccessTokenSecret" />
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleShowPassword("TwitterTokenSecret")'>
                                    <i class="bi @(showPasswords.Contains("TwitterTokenSecret") ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 text-end">
            <button class="btn btn-primary btn-lg px-4 d-inline-flex align-items-center gap-2 shadow-sm" @onclick="SaveAllAsync" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle fs-5"></i>
                    <span>Save All Changes</span>
                }
            </button>
        </div>
    }
</div>

@code {
    private IntegrationSettingsModel model = new();
    private HashSet<string> showPasswords = new(StringComparer.OrdinalIgnoreCase);
    private bool isLoading = true;
    private bool isSaving = false;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        isLoading = true;
        try
        {
            model = await SettingsService.GetIntegrationSettingsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load integration settings.");
            errorMessage = "Failed to load integration settings: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleShowPassword(string key)
    {
        if (showPasswords.Contains(key))
        {
            showPasswords.Remove(key);
        }
        else
        {
            showPasswords.Add(key);
        }
    }

    private async Task SaveAllAsync()
    {
        isSaving = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            await SettingsService.SaveIntegrationSettingsAsync(model);
            successMessage = "All integration keys and settings have been saved successfully to the database!";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save integration settings.");
            errorMessage = "Failed to save integration settings: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
