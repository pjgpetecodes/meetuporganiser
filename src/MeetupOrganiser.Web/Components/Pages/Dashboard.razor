@page "/dashboard"
@attribute [Authorize]
@using MeetupOrganiser.Core.Entities
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject NavigationManager NavManager
@inject IMeetupService MeetupService
@inject ILogger<Dashboard> Logger

<PageTitle>Organizer Dashboard - Meetup Organiser</PageTitle>

<div class="container-fluid py-2 dashboard-page">
    <div class="dashboard-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Organizer Command Center</h1>
            <p class="text-secondary mb-0">Overview of upcoming meetups, slide decks, and speaker assets.</p>
        </div>
        <div class="d-flex gap-2">
            <details class="events-action-dropdown">
                <summary class="btn btn-primary dropdown-toggle shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Create Event
                </summary>
                <div class="events-action-dropdown-menu">
                    <a href="/events/new" class="dropdown-item">
                        <i class="bi bi-plus-circle me-2"></i> New Event
                    </a>
                    <a href="/events/invite" class="dropdown-item">
                        <i class="bi bi-send me-2"></i> Quick Invite
                    </a>
                </div>
            </details>
            <a href="/speakers" class="btn btn-outline-secondary">
                <i class="bi bi-person-plus me-1"></i> Add Speaker
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4 dashboard-stats">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small text-uppercase fw-bold">Total Events</div>
                        <h3 class="fw-bold mb-0">@totalEvents</h3>
                    </div>
                    <div class="fs-2 text-primary opacity-50"><i class="bi bi-calendar-event"></i></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small text-uppercase fw-bold">Upcoming Scheduled</div>
                        <h3 class="fw-bold mb-0">@upcomingEventsCount</h3>
                    </div>
                    <div class="fs-2 text-success opacity-50"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small text-uppercase fw-bold">Speakers in Directory</div>
                        <h3 class="fw-bold mb-0">@totalSpeakers</h3>
                    </div>
                    <div class="fs-2 text-info opacity-50"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small text-uppercase fw-bold">Meetup Groups</div>
                        <h3 class="fw-bold mb-0">@totalGroups</h3>
                    </div>
                    <div class="fs-2 text-warning opacity-50"><i class="bi bi-collection"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Events List -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom dashboard-events-header">
            <h5 class="fw-bold mb-0"><i class="bi bi-calendar-check me-2 text-primary"></i> Upcoming Meetups</h5>
            <a href="/events" class="btn btn-sm btn-outline-primary">View All Events</a>
        </div>
        <div class="card-body p-0">
            @if (upcomingEvents == null)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (!upcomingEvents.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-secondary fs-1 mb-2"></i>
                    <p class="text-secondary mb-3">No upcoming meetups scheduled.</p>
                    <a href="/events/new" class="btn btn-primary">Create Your First Meetup</a>
                </div>
            }
            else
            {
                <div class="table-responsive dashboard-events-table">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Event Title</th>
                                <th>Group</th>
                                <th>Date &amp; Time</th>
                                <th>Speaker(s)</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in upcomingEvents)
                            {
                                <tr>
                                    <td>
                                        <a href="/events/edit/@evt.Id" class="fw-bold text-decoration-none text-reset" title="Edit event">@evt.Title</a>
                                        @if (!string.IsNullOrWhiteSpace(evt.ShortBitlyUrl))
                                        {
                                            <div class="small">
                                                @if (IsSafeExternalUrl(evt.ShortBitlyUrl))
                                                {
                                                    <a href="@evt.ShortBitlyUrl" target="_blank" rel="noopener noreferrer">@evt.ShortBitlyUrl</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">@evt.ShortBitlyUrl</span>
                                                }
                                            </div>
                                        }
                                        @if (IsSafeExternalUrl(evt.MeetupEventUrl))
                                        {
                                            <div class="small">
                                                <a href="@evt.MeetupEventUrl" target="_blank" rel="noopener noreferrer">
                                                    <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Meetup event
                                                </a>
                                            </div>
                                        }
                                        @if (evt.Status is EventStatus.Published or EventStatus.Completed)
                                        {
                                            <div class="small text-secondary d-flex align-items-center gap-1">
                                                <i class="bi bi-people-fill" title="Meetup attendees" aria-hidden="true"></i>
                                                <span>@(evt.MeetupAttendeeCount?.ToString("N0") ?? "—")</span>
                                                @if (IsSafeExternalUrl(evt.MeetupEventUrl))
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-link p-0 ms-1 text-secondary"
                                                            title="Refresh attendee count"
                                                            aria-label="@($"Refresh attendee count for {evt.Title}")"
                                                            disabled="@refreshingAttendanceEventIds.Contains(evt.Id)"
                                                            @onclick="() => RefreshAttendanceAsync(evt)">
                                                        @if (refreshingAttendanceEventIds.Contains(evt.Id))
                                                        {
                                                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                            @if (attendanceMessages.TryGetValue(evt.Id, out var attendanceMessage))
                                            {
                                                <div class="small @(attendanceMessage.IsError ? "text-danger" : "text-success")">@attendanceMessage.Text</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            @(evt.MeetupGroup?.Name ?? ".NET Notts")
                                        </span>
                                    </td>
                                    <td>
                                        <div>@evt.EventDateTimeUtc.ToString("MMM dd, yyyy")</div>
                                        <div class="small text-secondary">@evt.EventDateTimeUtc.ToString("HH:mm UTC")</div>
                                    </td>
                                    <td>
                                        @if (evt.Sessions.Any())
                                        {
                                            @foreach (var s in evt.Sessions)
                                            {
                                                <div class="small d-flex align-items-center gap-2 mb-1">
                                                    @if (s.Speaker != null)
                                                    {
                                                        <a href="/speakers/edit/@s.Speaker.Id" title="Edit @s.Speaker.Name">
                                                            @if (!string.IsNullOrWhiteSpace(s.Speaker.PhotoBlobUrl))
                                                            {
                                                                <img src="@s.Speaker.PhotoBlobUrl" alt="@s.Speaker.Name" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-person-fill text-primary"></i>
                                                            }
                                                        </a>
                                                        <span><a href="/speakers/edit/@s.Speaker.Id" class="fw-bold text-reset text-decoration-none" title="Edit @s.Speaker.Name">@s.Speaker.Name</a>: @s.TalkTitle</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-person-fill text-primary"></i>
                                                        <span><strong>Speaker</strong>: @s.TalkTitle</span>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No speakers assigned</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(evt.Status)">@evt.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="events-row-desktop-actions">
                                            <a href="/events/edit/@evt.Id" class="row-action row-action-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a href="/events/edit/@evt.Id?tab=assets" class="row-action" title="Slide Deck & Social Cards" aria-label="Assets">
                                                <i class="bi bi-file-earmark-slides"></i>
                                            </a>
                                        </div>
                                        <div class="events-compact-actions event-row-actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" popovertarget="@($"dash-event-actions-{evt.Id}")" aria-label="@($"Actions for {evt.Title}")">
                                                <i class="bi bi-three-dots" aria-hidden="true"></i>
                                            </button>
                                            <div id="@($"dash-event-actions-{evt.Id}")" class="event-row-action-items" popover="auto">
                                                <a href="/events/edit/@evt.Id" class="dropdown-item">
                                                    <i class="bi bi-pencil me-2" aria-hidden="true"></i> Edit
                                                </a>
                                                <a href="/events/edit/@evt.Id?tab=assets" class="dropdown-item">
                                                    <i class="bi bi-file-earmark-slides me-2" aria-hidden="true"></i> Slides &amp; Assets
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="dashboard-event-cards">
                    @foreach (var evt in upcomingEvents)
                    {
                        <article class="dashboard-event-card">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="min-w-0">
                                    <h2 class="h6 fw-bold mb-1">
                                        <a href="/events/edit/@evt.Id" class="text-decoration-none text-reset">@evt.Title</a>
                                    </h2>
                                    <div class="small text-secondary">
                                        <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>
                                        @evt.EventDateTimeUtc.ToString("ddd, MMM dd, yyyy")
                                        <span class="d-block ms-4">@evt.EventDateTimeUtc.ToString("HH:mm UTC")</span>
                                    </div>
                                </div>
                                <span class="badge @GetStatusBadgeClass(evt.Status) flex-shrink-0">@evt.Status</span>
                            </div>
                            <div class="dashboard-event-meta">
                                <span class="badge bg-secondary-subtle text-secondary border">@(evt.MeetupGroup?.Name ?? ".NET Notts")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(evt.ShortBitlyUrl))
                            {
                                <div class="small dashboard-event-link">
                                    @if (IsSafeExternalUrl(evt.ShortBitlyUrl))
                                    {
                                        <a href="@evt.ShortBitlyUrl" target="_blank" rel="noopener noreferrer">@evt.ShortBitlyUrl</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@evt.ShortBitlyUrl</span>
                                    }
                                </div>
                            }
                            @if (IsSafeExternalUrl(evt.MeetupEventUrl))
                            {
                                <div class="small dashboard-event-link">
                                    <a href="@evt.MeetupEventUrl" target="_blank" rel="noopener noreferrer">
                                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Meetup event
                                    </a>
                                </div>
                            }
                            @if (evt.Status is EventStatus.Published or EventStatus.Completed)
                            {
                                <div class="small text-secondary d-flex align-items-center gap-1 mt-2">
                                    <i class="bi bi-people-fill" title="Meetup attendees" aria-hidden="true"></i>
                                    <span>@(evt.MeetupAttendeeCount?.ToString("N0") ?? "—") attendees</span>
                                    @if (IsSafeExternalUrl(evt.MeetupEventUrl))
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-link p-0 ms-1 text-secondary dashboard-refresh-button"
                                                title="Refresh attendee count"
                                                aria-label="@($"Refresh attendee count for {evt.Title}")"
                                                disabled="@refreshingAttendanceEventIds.Contains(evt.Id)"
                                                @onclick="() => RefreshAttendanceAsync(evt)">
                                            @if (refreshingAttendanceEventIds.Contains(evt.Id))
                                            {
                                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                            }
                                        </button>
                                    }
                                </div>
                                @if (attendanceMessages.TryGetValue(evt.Id, out var cardAttendanceMessage))
                                {
                                    <div class="small @(cardAttendanceMessage.IsError ? "text-danger" : "text-success")">@cardAttendanceMessage.Text</div>
                                }
                            }
                            <div class="dashboard-event-speakers">
                                <div class="small fw-semibold text-secondary mb-1">Speakers</div>
                                @if (evt.Sessions.Any())
                                {
                                    @foreach (var s in evt.Sessions)
                                    {
                                        <div class="small d-flex align-items-start gap-2 mb-1">
                                            @if (s.Speaker != null)
                                            {
                                                <a href="/speakers/edit/@s.Speaker.Id" title="Edit @s.Speaker.Name" class="flex-shrink-0">
                                                    @if (!string.IsNullOrWhiteSpace(s.Speaker.PhotoBlobUrl))
                                                    {
                                                        <img src="@s.Speaker.PhotoBlobUrl" alt="@s.Speaker.Name" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-person-fill text-primary"></i>
                                                    }
                                                </a>
                                                <span><a href="/speakers/edit/@s.Speaker.Id" class="fw-bold text-reset text-decoration-none">@s.Speaker.Name</a>: @s.TalkTitle</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-fill text-primary" aria-hidden="true"></i>
                                                <span><strong>Speaker</strong>: @s.TalkTitle</span>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">No speakers assigned</span>
                                }
                            </div>
                            <div class="dashboard-event-actions">
                                <a href="/events/edit/@evt.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
                                </a>
                                <a href="/events/edit/@evt.Id?tab=assets" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-file-earmark-slides me-1" aria-hidden="true"></i>Assets
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int totalEvents = 0;
    private int upcomingEventsCount = 0;
    private int totalSpeakers = 0;
    private int totalGroups = 0;
    private List<MeetupEvent>? upcomingEvents;
    private bool hasStartedPublishedAttendanceRefresh;
    private readonly HashSet<Guid> refreshingAttendanceEventIds = [];
    private readonly Dictionary<Guid, AttendanceMessage> attendanceMessages = [];

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.UtcNow.Date;
        totalEvents = await DbContext.MeetupEvents.CountAsync();
        upcomingEventsCount = await DbContext.MeetupEvents.CountAsync(e => e.EventDateTimeUtc >= today);
        totalSpeakers = await DbContext.Speakers.CountAsync();
        totalGroups = await DbContext.MeetupGroups.CountAsync();

        upcomingEvents = await DbContext.MeetupEvents
            .Where(e => e.EventDateTimeUtc >= today &&
                        (e.Status == EventStatus.Draft ||
                         e.Status == EventStatus.Scheduled ||
                         e.Status == EventStatus.Published))
            .Include(e => e.MeetupGroup).ThenInclude(g => g!.Sponsors)
            .Include(e => e.Sessions)
                .ThenInclude(s => s.Speaker)
            .OrderBy(e => e.EventDateTimeUtc)
            .Take(5)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasStartedPublishedAttendanceRefresh || upcomingEvents == null) return;

        hasStartedPublishedAttendanceRefresh = true;
        foreach (var evt in upcomingEvents.Where(item =>
                     item.Status == EventStatus.Published
                     && IsSafeExternalUrl(item.MeetupEventUrl)))
        {
            await RefreshAttendanceAsync(evt, showStatus: false);
        }
    }

    private async Task RefreshAttendanceAsync(MeetupEvent evt, bool showStatus = true)
    {
        if (!refreshingAttendanceEventIds.Add(evt.Id)) return;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(evt.MeetupEventUrl))
            {
                throw new InvalidOperationException("This event does not have a Meetup event URL.");
            }

            var attendeeCount = await MeetupService.GetAttendeeCountAsync(evt.MeetupEventUrl);
            if (attendeeCount == null)
            {
                Logger.LogInformation("Meetup did not expose an attendee count for event {EventId}.", evt.Id);
                if (showStatus)
                {
                    attendanceMessages[evt.Id] = new AttendanceMessage(
                        "Meetup's event page did not include an attendee count.",
                        IsError: true);
                }
                return;
            }

            var eventToUpdate = await DbContext.MeetupEvents.FindAsync(evt.Id);
            if (eventToUpdate == null)
            {
                throw new InvalidOperationException("The event could not be found while saving its attendee count.");
            }

            eventToUpdate.MeetupAttendeeCount = attendeeCount.Value;
            eventToUpdate.UpdatedAtUtc = DateTime.UtcNow;
            await DbContext.SaveChangesAsync();
            evt.MeetupAttendeeCount = attendeeCount.Value;
            attendanceMessages[evt.Id] = new AttendanceMessage(
                $"Updated: {attendeeCount.Value:N0} attendee(s).",
                IsError: false);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh Meetup attendee count for event {EventId}.", evt.Id);
            if (showStatus)
            {
                attendanceMessages[evt.Id] = new AttendanceMessage(
                    "Unable to refresh the Meetup attendee count.",
                    IsError: true);
            }
        }
        finally
        {
            refreshingAttendanceEventIds.Remove(evt.Id);
            StateHasChanged();
        }
    }

    private static bool IsSafeExternalUrl(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);

    private sealed record AttendanceMessage(string Text, bool IsError);

    private static string GetStatusBadgeClass(EventStatus status) => status switch
    {
        EventStatus.Published => "bg-success text-white",
        EventStatus.Scheduled => "bg-primary text-white",
        EventStatus.Draft => "bg-warning text-dark",
        EventStatus.Completed => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };
}
