@page "/events/new"
@page "/events/edit/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using MeetupOrganiser.Core.Entities
@using MeetupOrganiser.Core.Services
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Core.DTOs
@using MeetupOrganiser.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IMagicLinkService MagicLinkService
@inject IZoomService ZoomService
@inject ISessionizeService SessionizeService
@inject IMeetupService MeetupService
@inject ISettingsService SettingsService
@inject NavigationManager NavManager
@inject ILogger<EventEdit> Logger
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "New Event" : "Edit Event") - Meetup Organiser</PageTitle>

<div class="container-fluid py-2 event-edit-page">
    <div class="d-flex justify-content-between align-items-center mb-4 page-heading">
        <div>
            <h1 class="h3 fw-bold mb-1">@(IsNew ? "Create Meetup Event" : "Edit Meetup Event")</h1>
            <p class="text-secondary mb-0">Configure event details, speakers, talks, and cloud integrations.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/events" class="btn btn-outline-secondary">Back to Events</a>
        </div>
    </div>

    @if (statusMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (evt == null)
    {
        @if (statusMessage == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">The event editor could not be loaded. Use <a href="/events">Back to Events</a> to return to the event list.</div>
        }
    }
    else
    {
        @if (!IsNew)
        {
            <ul class="nav nav-tabs mb-4 page-tabs">
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "edit" ? "active" : "")" @onclick='() => activeTab = "edit"'>
                        <i class="bi bi-pencil me-1"></i> Edit
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(activeTab == "assets" ? "active" : "")" @onclick='() => activeTab = "assets"'>
                        <i class="bi bi-file-earmark-slides me-1"></i> Social &amp; Slides
                    </button>
                </li>
            </ul>
        }

        @if (activeTab == "assets" && !IsNew)
        {
            <EventAssets EventId="Id!.Value" />
        }

        <div class="row g-4 @(activeTab == "assets" && !IsNew ? "d-none" : "")">
            <!-- Left Column: Core Event Information -->
            <div class="col-lg-5 order-lg-2">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-calendar4-event me-2 text-primary"></i>Event Details</h5>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Meetup Group</label>
                        <select class="form-select" @bind="evt.MeetupGroupId">
                            @if (groups != null)
                            {
                                @foreach (var g in groups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Event Title</label>
                        <input type="text" class="form-control" placeholder="e.g. Building Cloud-Native Apps with .NET 10" @bind="evt.Title" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Event Description / Agenda</label>
                        <textarea class="form-control" rows="14" placeholder="Overview of the event, talks, and timetable..." @bind="evt.Description"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Date &amp; Start Time (Local)</label>
                            <input type="datetime-local" class="form-control" @bind="localEventDateTime" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Duration (Mins)</label>
                            <input type="number" class="form-control" @bind="evt.DurationMinutes" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Status</label>
                            <select class="form-select" @bind="evt.Status">
                                <option value="@EventStatus.Draft">Draft</option>
                                <option value="@EventStatus.Scheduled">Scheduled</option>
                                <option value="@EventStatus.Published">Published</option>
                                <option value="@EventStatus.Completed">Completed</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Event Format</label>
                            <select class="form-select" @bind="evt.Format">
                                <option value="@EventFormat.Hybrid">Hybrid (in person + Zoom)</option>
                                <option value="@EventFormat.InPerson">In Person only</option>
                                <option value="@EventFormat.Online">Online only (Zoom)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Venue Name</label>
                            <input type="text" class="form-control" placeholder="CGI" @bind="evt.VenueName" disabled="@(evt.Format == EventFormat.Online)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Promo Subtitle (optional)</label>
                            <input type="text" class="form-control" placeholder="e.g. Special Workshop Edition!" @bind="evt.Subtitle" />
                        </div>
                        <div class="col-12">
                            <div class="form-text">Promo header preview: <strong>@EventHeaderPreview</strong></div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Location / Platform</label>
                            <input type="text" class="form-control" placeholder="Zoom / Online / Nottingham, UK" @bind="evt.LocationOrPlatform" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bitly / Short URL</label>
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="https://bit.ly/dotnetnottsoctober2026" @bind="evt.ShortBitlyUrl" />
                                <button type="button" class="btn btn-outline-secondary" title="Use the group's short URL stem plus month and year" @onclick="ApplyShortUrlDefault" disabled="@(SuggestedShortUrl == null)">Use default</button>
                            </div>
                            @if (SuggestedShortUrl != null)
                            {
                                <div class="form-text">Default: @SuggestedShortUrl</div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Meetup.com Event URL</label>
                        <input type="text" class="form-control" placeholder="https://www.meetup.com/dotnetnotts/events/..." @bind="evt.MeetupEventUrl" />
                    </div>
                </div>

                <!-- Integrations Card: Zoom & Sessionize -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>API Integrations</h5>

                    <!-- Zoom Meeting Generator -->
                    <div class="p-3 bg-light rounded mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="fw-semibold"><i class="bi bi-camera-video me-2 text-primary"></i>Zoom Meeting</div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CreateZoomMeetingAsync" disabled="@isGeneratingZoom">
                                @if (isGeneratingZoom)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Generating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-plus-lg me-1"></i>
                                    <span>Generate Zoom Link</span>
                                }
                            </button>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" placeholder="Zoom Join URL" @bind="evt.ZoomMeetingUrl" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" class="form-control form-control-sm" placeholder="Passcode" @bind="evt.ZoomPasscode" />
                            </div>
                        </div>
                    </div>

                    <!-- Sessionize Sync -->
                    <div class="p-3 bg-light rounded">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="fw-semibold"><i class="bi bi-cloud-arrow-down me-2 text-info"></i>Sessionize Sync</div>
                            <button type="button" class="btn btn-sm btn-outline-info" @onclick="SyncFromSessionizeAsync" disabled="@isSyncingSessionize">
                                @if (isSyncingSessionize)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Syncing...</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat me-1"></i>
                                    <span>Pull Sessions</span>
                                }
                            </button>
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Sessionize API ID</span>
                            <input type="text" class="form-control" placeholder="e.g. abcdef123" @bind="sessionizeEventId" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Speakers & Sessions -->
            <div class="col-lg-7 order-first order-lg-1">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 speaker-session-heading">
                        <h5 class="fw-bold mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>Speakers &amp; Sessions</h5>
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="speakerCount" id="btnradio1" autocomplete="off" checked="@(speakerCount == 1)" @onchange="() => SetSpeakerCount(1)">
                            <label class="btn btn-outline-primary" for="btnradio1">1 Speaker</label>

                            <input type="radio" class="btn-check" name="speakerCount" id="btnradio2" autocomplete="off" checked="@(speakerCount == 2)" @onchange="() => SetSpeakerCount(2)">
                            <label class="btn btn-outline-primary" for="btnradio2">2 Speakers</label>
                        </div>
                    </div>

                    <!-- Speaker 1 Session -->
                    <div class="border rounded p-3 mb-3 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2 integration-heading">
                            <span class="badge bg-primary">Speaker 1</span>
                            @if (session1 != null)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => GenerateMagicLinkAsync(0)">
                                    <i class="bi bi-link-45deg me-1"></i> Magic Link
                                </button>
                            }
                        </div>

                        @if (magicLinkUrl1 != null)
                        {
                            <div class="alert alert-info py-2 px-3 small mb-2">
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                    <input type="text" readonly class="form-control form-control-sm" value="@magicLinkUrl1" @onfocus="SelectAllAsync" />
                                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => CopyToClipboardAsync(magicLinkUrl1)">@(copiedLink == magicLinkUrl1 ? "Copied!" : "Copy")</button>
                                </div>
                                <EmailLinkForm Link="@magicLinkUrl1" AutoSend="true" InitialEmail="@SelectedSpeaker(session1SpeakerId)?.Email"
                                               SpeakerName="@SelectedSpeaker(session1SpeakerId)?.Name" SpeakerId="@SelectedSpeaker(session1SpeakerId)?.Id"
                                               EventTitle="@(evt?.Title ?? string.Empty)" EventDateUtc="@evt?.EventDateTimeUtc"
                                               OnSent="e => OnLinkEmailed(session1SpeakerId, e)" />
                            </div>
                        }

                        @if (SelectedSpeaker(session1SpeakerId) is { IsPlaceholder: false } current1 && !changeSpeaker1)
                        {
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <SpeakerAvatar Speaker="current1" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@current1.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(session1.TalkTitle))
                                    {
                                        <div class="small text-secondary">@session1.TalkTitle</div>
                                    }
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => changeSpeaker1 = true">
                                    <i class="bi bi-arrow-left-right me-1"></i> Change speaker or talk
                                </button>
                            </div>
                        }
                        else
                        {
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Select Speaker</label>
                            <select class="form-select form-select-sm" @bind="session1SpeakerId">
                                <option value="">-- Choose or create speaker --</option>
                                @if (speakers != null)
                                {
                                    @foreach (var s in speakers)
                                    {
                                        <option value="@s.Id.ToString()">@(s.IsPlaceholder ? "Speaker TBC (awaiting speaker details)" : $"{s.Name} ({s.Email})")</option>
                                    }
                                }
                            </select>
                            @if (SelectedSpeaker(session1SpeakerId) is { } sp1)
                            {
                                <div class="mt-2"><SessionizeTalkPicker @key="sp1.Id" Speaker="sp1" OnPick="s => OnTalkPicked(session1, sp1, s)" OnNewTalk="() => OnNewTalk(session1)" /></div>
                                <details class="mt-1">
                                    <summary class="small text-primary" style="cursor: pointer;">Look up @sp1.Name on Sessionize</summary>
                                    <div class="mt-2"><SessionizeProfileLookup @key="sp1.Id" InitialQuery="@sp1.Name" Current="sp1" OnApply="r => ApplyProfileToSpeakerAsync(sp1, r)" /></div>
                                </details>
                                @if (!sp1.IsPlaceholder)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => changeSpeaker1 = false">Done</button>
                                }
                            }
                        </div>
                        }

                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Talk Title</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Title of talk..." @bind="session1.TalkTitle" @bind:after="RefreshEventTitle" />
                        </div>

                        <div class="mb-1">
                            <label class="form-label small fw-semibold">Talk Abstract</label>
                            <textarea class="form-control form-control-sm" rows="3" placeholder="Talk abstract and description..." @bind="session1.TalkDescription"></textarea>
                        </div>
                    </div>

                    <!-- Speaker 2 Session (if 2 speakers selected) -->
                    @if (speakerCount >= 2)
                    {
                        <div class="border rounded p-3 mb-3 bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2 integration-heading">
                                <span class="badge bg-info text-dark">Speaker 2</span>
                                @if (session2 != null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => GenerateMagicLinkAsync(1)">
                                        <i class="bi bi-link-45deg me-1"></i> Magic Link
                                    </button>
                                }
                            </div>

                            @if (magicLinkUrl2 != null)
                            {
                                <div class="alert alert-info py-2 px-3 small mb-2">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <input type="text" readonly class="form-control form-control-sm" value="@magicLinkUrl2" @onfocus="SelectAllAsync" />
                                        <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => CopyToClipboardAsync(magicLinkUrl2)">@(copiedLink == magicLinkUrl2 ? "Copied!" : "Copy")</button>
                                    </div>
                                    <EmailLinkForm Link="@magicLinkUrl2" AutoSend="true" InitialEmail="@SelectedSpeaker(session2SpeakerId)?.Email"
                                                   SpeakerName="@SelectedSpeaker(session2SpeakerId)?.Name" SpeakerId="@SelectedSpeaker(session2SpeakerId)?.Id"
                                                   EventTitle="@(evt?.Title ?? string.Empty)" EventDateUtc="@evt?.EventDateTimeUtc"
                                                   OnSent="e => OnLinkEmailed(session2SpeakerId, e)" />
                                </div>
                            }

                            @if (SelectedSpeaker(session2SpeakerId) is { IsPlaceholder: false } current2 && !changeSpeaker2)
                            {
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <SpeakerAvatar Speaker="current2" />
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">@current2.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(session2.TalkTitle))
                                        {
                                            <div class="small text-secondary">@session2.TalkTitle</div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => changeSpeaker2 = true">
                                        <i class="bi bi-arrow-left-right me-1"></i> Change speaker or talk
                                    </button>
                                </div>
                            }
                            else
                            {
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Select Speaker</label>
                                <select class="form-select form-select-sm" @bind="session2SpeakerId">
                                    <option value="">-- Choose or create speaker --</option>
                                    @if (speakers != null)
                                    {
                                        @foreach (var s in speakers)
                                        {
                                            <option value="@s.Id.ToString()">@(s.IsPlaceholder ? "Speaker TBC (awaiting speaker details)" : $"{s.Name} ({s.Email})")</option>
                                        }
                                    }
                                </select>
                                @if (SelectedSpeaker(session2SpeakerId) is { } sp2)
                                {
                                    <div class="mt-2"><SessionizeTalkPicker @key="sp2.Id" Speaker="sp2" OnPick="s => OnTalkPicked(session2, sp2, s)" OnNewTalk="() => OnNewTalk(session2)" /></div>
                                    <details class="mt-1">
                                        <summary class="small text-primary" style="cursor: pointer;">Look up @sp2.Name on Sessionize</summary>
                                        <div class="mt-2"><SessionizeProfileLookup @key="sp2.Id" InitialQuery="@sp2.Name" Current="sp2" OnApply="r => ApplyProfileToSpeakerAsync(sp2, r)" /></div>
                                    </details>
                                    @if (!sp2.IsPlaceholder)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => changeSpeaker2 = false">Done</button>
                                    }
                                }
                            </div>
                            }

                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Talk Title</label>
                                <input type="text" class="form-control form-control-sm" placeholder="Title of talk..." @bind="session2.TalkTitle" @bind:after="RefreshEventTitle" />
                            </div>

                            <div class="mb-1">
                                <label class="form-label small fw-semibold">Talk Abstract</label>
                                <textarea class="form-control form-control-sm" rows="3" placeholder="Talk abstract and description..." @bind="session2.TalkDescription"></textarea>
                            </div>
                        </div>
                    }

                    <div class="d-grid gap-2 mt-4">
                        <button type="button" class="btn btn-primary btn-lg" @onclick="SaveEventAsync" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                                <span>Save Event</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .event-edit-page .page-heading { gap: 1rem; }
    .event-edit-page .page-tabs { flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; }
    .event-edit-page .page-tabs .nav-link { white-space: nowrap; }
    .event-edit-page .input-group { min-width: 0; }
    .event-edit-page .input-group > .form-control { min-width: 0; }
    .event-edit-page .card h5 { overflow-wrap: anywhere; }
    .event-edit-page .speaker-session-heading { flex-wrap: wrap; gap: .5rem; }
    .event-edit-page .integration-heading { flex-wrap: wrap; gap: .5rem; }
    @@media (max-width: 575.98px) {
        .event-edit-page .page-heading { flex-direction: column; align-items: flex-start !important; }
        .event-edit-page .page-heading > div:last-child,
        .event-edit-page .page-heading > div:last-child .btn { width: auto; }
        .event-edit-page .card { padding: 1rem !important; }
        .event-edit-page .speaker-session-heading,
        .event-edit-page .integration-heading { align-items: flex-start !important; }
        .event-edit-page .speaker-session-heading > h5 { flex: 1 1 100%; }
        .event-edit-page .input-group { flex-wrap: wrap; }
        .event-edit-page .input-group > .form-control { flex: 1 1 100%; width: 100%; border-radius: var(--bs-border-radius) !important; }
        .event-edit-page .input-group > .btn,
        .event-edit-page .input-group > .input-group-text { flex: 1 1 100%; width: 100%; justify-content: center; border-radius: var(--bs-border-radius) !important; }
        .event-edit-page .btn-group { flex-wrap: wrap; }
        .event-edit-page .btn-group > .btn { flex: 1 1 auto; }
        .event-edit-page .alert .input-group { gap: .5rem; }
        .event-edit-page .alert .d-flex { flex-wrap: wrap; }
        .event-edit-page .alert .d-flex > .form-control { flex: 1 1 100%; width: 100%; }
        .event-edit-page .alert .d-flex > .btn { flex: 1 1 100%; }
        .event-edit-page .speaker-session-heading > .btn-group { width: 100%; }
    }
</style>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string activeTab = "edit";

    protected override void OnParametersSet()
    {
        if (string.Equals(Tab, "assets", StringComparison.OrdinalIgnoreCase)) activeTab = "assets";
    }

    private bool persisted;
    private bool IsNew => !Id.HasValue && !persisted;

    private MeetupEvent? evt;
    private AppDbContext? dbContext;
    private List<MeetupGroup>? groups;
    private List<Speaker>? speakers;

    private DateTime localEventDateTime = DateTime.Now.AddDays(14).Date.AddHours(18).AddMinutes(30);
    private int speakerCount = 1;

    private EventSpeakerSession session1 = new() { OrderIndex = 0 };
    private EventSpeakerSession session2 = new() { OrderIndex = 1 };

    private string session1SpeakerId = string.Empty;
    private string session2SpeakerId = string.Empty;

    private bool changeSpeaker1;
    private bool changeSpeaker2;

    private string? magicLinkUrl1;
    private string? magicLinkUrl2;
    private string? copiedLink;
    private string sessionizeEventId = "sample-sessionize";

    private bool isSaving;
    private bool isGeneratingZoom;
    private bool isSyncingSessionize;

    private string? SuggestedShortUrl => evt == null
        ? null
        : ShortUrl.ForEvent(groups?.FirstOrDefault(g => g.Id == evt.MeetupGroupId)?.ShortUrlStem, localEventDateTime.ToUniversalTime());

    private void ApplyShortUrlDefault()
    {
        if (evt != null && SuggestedShortUrl is { } url) evt.ShortBitlyUrl = url;
    }

    private string EventHeaderPreview
    {
        get
        {
            if (evt == null) return string.Empty;
            var preview = new MeetupEvent
            {
                EventDateTimeUtc = localEventDateTime.ToUniversalTime(),
                Format = evt.Format,
                VenueName = evt.VenueName,
                Subtitle = evt.Subtitle
            };
            var lines = new List<string> { EventHeader.DateLine(preview), EventHeader.VenueLine(preview) };
            if (EventHeader.Subtitle(preview) is { } subtitle) lines.Add(subtitle);
            return string.Join(" / ", lines);
        }
    }

    private async Task OnTalkPicked(EventSpeakerSession session, Speaker speaker, SessionizeProfileSession talk)
    {
        session.TalkTitle = talk.Title;
        session.TalkDescription = SpeakerBio.ResolveTalkDescription(talk.Summary, speaker);

        RefreshEventTitle();
        await PopulateEventDescriptionAsync();
    }

    private async Task PopulateEventDescriptionAsync()
    {
        if (evt == null) return;

        var preview = new MeetupEvent
        {
            Title = evt.Title,
            EventDateTimeUtc = localEventDateTime.ToUniversalTime(),
            LocationOrPlatform = evt.LocationOrPlatform,
            ZoomMeetingUrl = evt.ZoomMeetingUrl,
            ZoomPasscode = evt.ZoomPasscode,
            MeetupGroup = groups?.FirstOrDefault(g => g.Id == evt.MeetupGroupId)
        };

        var slots = new List<(EventSpeakerSession Session, string SpeakerId)> { (session1, session1SpeakerId) };
        if (speakerCount >= 2) slots.Add((session2, session2SpeakerId));

        foreach (var (session, speakerId) in slots)
        {
            if (string.IsNullOrWhiteSpace(session.TalkTitle)) continue;
            preview.Sessions.Add(new EventSpeakerSession
            {
                OrderIndex = session.OrderIndex,
                TalkTitle = session.TalkTitle,
                TalkDescription = session.TalkDescription,
                Speaker = SelectedSpeaker(speakerId)
            });
        }

        var group = preview.MeetupGroup;
        var preference = !string.IsNullOrWhiteSpace(group?.BioPreference) ? group.BioPreference : await SettingsService.GetSettingAsync(SpeakerBio.SettingKey);
        var template = (!string.IsNullOrWhiteSpace(group?.MeetupDescriptionTemplate) ? group.MeetupDescriptionTemplate : null)
            ?? await SettingsService.GetSettingAsync(MeetupDescriptionTemplate.SettingKey) ?? MeetupDescriptionTemplate.Default;
        evt.Description = MeetupService.GenerateMeetupDescription(preview, preference, template);
    }

    private void OnNewTalk(EventSpeakerSession session)
    {
        session.TalkTitle = string.Empty;
        session.TalkDescription = string.Empty;
    }

    private void RefreshEventTitle()
    {
        if (evt == null) return;

        var parts = new List<(string Title, string Name)>();
        if (Guid.TryParse(session1SpeakerId, out _) && !string.IsNullOrWhiteSpace(session1.TalkTitle))
            parts.Add((session1.TalkTitle, SelectedSpeaker(session1SpeakerId)?.Name ?? string.Empty));
        if (speakerCount >= 2 && Guid.TryParse(session2SpeakerId, out _) && !string.IsNullOrWhiteSpace(session2.TalkTitle))
            parts.Add((session2.TalkTitle, SelectedSpeaker(session2SpeakerId)?.Name ?? string.Empty));

        if (parts.Count > 0)
        {
            evt.Title = string.Join(" | ", parts.Select(p => $"{p.Title} - {p.Name}"));
        }
    }
    private Speaker? SelectedSpeaker(string id) =>
        Guid.TryParse(id, out var guid) ? speakers?.FirstOrDefault(s => s.Id == guid) : null;

    private async Task ApplyProfileToSpeakerAsync(Speaker speaker, (SessionizeProfile Profile, SessionizeProfileFields Fields) result)
    {
        try
        {
            SessionizeSpeakerMapper.ApplyProfile(speaker, result.Profile, result.Fields);
            speaker.UpdatedAtUtc = DateTime.UtcNow;
            await DbContext.SaveChangesAsync();
            statusMessage = $"Updated {speaker.Name} from their Sessionize profile.";
            isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply Sessionize profile to speaker {SpeakerId}.", speaker.Id);
            statusMessage = "Unable to save the Sessionize profile data. The error has been logged.";
            isError = true;
        }
    }
    private string? statusMessage;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dbContext = await DbContextFactory.CreateDbContextAsync();
            groups = await dbContext.MeetupGroups.OrderBy(g => g.Name).ToListAsync();
            speakers = await dbContext.Speakers.OrderBy(s => s.Name).ToListAsync();

            if (IsNew)
            {
                evt = new MeetupEvent
                {
                    Id = Guid.NewGuid(),
                    MeetupGroupId = groups.FirstOrDefault()?.Id ?? Guid.Empty,
                    Title = string.Empty,
                    Description = string.Empty,
                    DurationMinutes = 90,
                    LocationOrPlatform = "CGI, King Street Nottingham & Online",
                    Format = EventFormat.Hybrid,
                    VenueName = "CGI",
                    Status = EventStatus.Draft,
                    CreatedAtUtc = DateTime.UtcNow,
                    UpdatedAtUtc = DateTime.UtcNow
                };
            }
            else
            {
                var eventId = Id ?? throw new InvalidOperationException("An event ID is required when editing an event.");
                evt = await dbContext.MeetupEvents
                    .Include(e => e.Sessions)
                        .ThenInclude(s => s.Speaker)
                    .FirstOrDefaultAsync(e => e.Id == eventId);

                if (evt == null)
                {
                    statusMessage = "The requested event could not be found.";
                    isError = true;
                    return;
                }

                localEventDateTime = evt.EventDateTimeUtc.ToLocalTime();
                var orderedSessions = evt.Sessions.OrderBy(s => s.OrderIndex).ToList();
                if (orderedSessions.Count > 0)
                {
                    session1 = orderedSessions[0];
                    session1SpeakerId = session1.SpeakerId.ToString();
                }
                if (orderedSessions.Count > 1)
                {
                    session2 = orderedSessions[1];
                    session2SpeakerId = session2.SpeakerId.ToString();
                    speakerCount = 2;
                }

                if (string.IsNullOrWhiteSpace(evt.Description) && !string.IsNullOrWhiteSpace(session1.TalkTitle))
                {
                    await PopulateEventDescriptionAsync();
                    statusMessage = "Event description was generated from the speaker details. Review it and click Save Event to keep it.";
                    isError = false;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load event {EventId} for editing.", Id);
            statusMessage = "Unable to load this event. Please reload and try again. The error has been logged.";
            isError = true;
        }
    }

    private void SetSpeakerCount(int count)
    {
        speakerCount = count;
    }

    private Task SaveEventAsync() => PersistEventAsync(navigateIfNew: true);

    private async Task<bool> PersistEventAsync(bool navigateIfNew)
    {
        if (evt == null) return false;

        if (string.IsNullOrWhiteSpace(evt.Title))
        {
            statusMessage = "Please enter an event title.";
            isError = true;
            return false;
        }

        try
        {
            isSaving = true;
            evt.EventDateTimeUtc = localEventDateTime.ToUniversalTime();
            evt.UpdatedAtUtc = DateTime.UtcNow;

            if (string.IsNullOrWhiteSpace(evt.ShortBitlyUrl)) ApplyShortUrlDefault();

            var wasNew = IsNew;
            if (wasNew)
            {
                await DbContext.MeetupEvents.AddAsync(evt);
                persisted = true;
            }

            // Sync session 1
            if (Guid.TryParse(session1SpeakerId, out var s1Id))
            {
                session1.SpeakerId = s1Id;
                session1.MeetupEventId = evt.Id;
                if (!evt.Sessions.Any(s => s.Id == session1.Id))
                {
                    evt.Sessions.Add(session1);
                }
            }

            // Sync session 2
            if (speakerCount >= 2 && Guid.TryParse(session2SpeakerId, out var s2Id))
            {
                session2.SpeakerId = s2Id;
                session2.MeetupEventId = evt.Id;
                if (!evt.Sessions.Any(s => s.Id == session2.Id))
                {
                    evt.Sessions.Add(session2);
                }
            }
            else if (speakerCount == 1 && session2.Id != Guid.Empty)
            {
                var existingS2 = evt.Sessions.FirstOrDefault(s => s.Id == session2.Id);
                if (existingS2 != null)
                {
                    evt.Sessions.Remove(existingS2);
                    DbContext.EventSpeakerSessions.Remove(existingS2);
                }
            }

            await DbContext.SaveChangesAsync();

            statusMessage = "Event successfully saved!";
            isError = false;

            if (wasNew && navigateIfNew)
            {
                NavManager.NavigateTo($"/events/edit/{evt.Id}");
            }
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save event.");
            statusMessage = $"Error saving event: {ex.Message}";
            isError = true;
            return false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CreateZoomMeetingAsync()
    {
        if (evt == null) return;
        try
        {
            isGeneratingZoom = true;
            var response = await ZoomService.CreateMeetingAsync(
                evt.Title.Length > 0 ? evt.Title : "Community Meetup",
                localEventDateTime,
                evt.DurationMinutes);

            if (response.Success)
            {
                evt.ZoomMeetingUrl = response.JoinUrl;
                evt.ZoomPasscode = response.Passcode;
                statusMessage = "Zoom meeting created successfully!";
                isError = false;
            }
            else
            {
                statusMessage = $"Zoom error: {response.ErrorMessage}";
                isError = true;
            }
        }
        finally
        {
            isGeneratingZoom = false;
        }
    }

    private async Task SyncFromSessionizeAsync()
    {
        try
        {
            isSyncingSessionize = true;
            var sessionsList = await SessionizeService.GetSessionsAsync(sessionizeEventId);
            var speakersList = await SessionizeService.GetSpeakersAsync(sessionizeEventId);
            var speakerMap = speakersList.ToDictionary(s => s.Id, s => s);

            if (sessionsList.Any())
            {
                var first = sessionsList[0];
                if (string.IsNullOrWhiteSpace(evt?.Title)) evt!.Title = first.Title;
                session1.TalkTitle = first.Title;
                session1.TalkDescription = first.Description;

                // Sync speaker
                if (first.SpeakerIds.Any() && speakerMap.TryGetValue(first.SpeakerIds[0], out var s))
                {
                    var existing = await DbContext.Speakers.FirstOrDefaultAsync(sp => sp.Name == s.FullName);
                    if (existing == null)
                    {
                        existing = new Speaker
                        {
                            Id = Guid.NewGuid(),
                            Name = s.FullName,
                            Bio = s.Bio,
                            PhotoBlobUrl = s.ProfilePicture,
                            CreatedAtUtc = DateTime.UtcNow,
                            UpdatedAtUtc = DateTime.UtcNow
                        };
                        SpeakerBio.EnsureThirdPerson(existing);
                        await DbContext.Speakers.AddAsync(existing);
                        await DbContext.SaveChangesAsync();
                        speakers = await DbContext.Speakers.OrderBy(sp => sp.Name).ToListAsync();
                    }
                    session1SpeakerId = existing.Id.ToString();
                }

                if (sessionsList.Count > 1)
                {
                    var second = sessionsList[1];
                    session2.TalkTitle = second.Title;
                    session2.TalkDescription = second.Description;
                    speakerCount = 2;

                    if (second.SpeakerIds.Any() && speakerMap.TryGetValue(second.SpeakerIds[0], out var s2))
                    {
                        var existing2 = await DbContext.Speakers.FirstOrDefaultAsync(sp => sp.Name == s2.FullName);
                        if (existing2 == null)
                        {
                            existing2 = new Speaker
                            {
                                Id = Guid.NewGuid(),
                                Name = s2.FullName,
                                Bio = s2.Bio,
                                PhotoBlobUrl = s2.ProfilePicture,
                                CreatedAtUtc = DateTime.UtcNow,
                                UpdatedAtUtc = DateTime.UtcNow
                            };
                            SpeakerBio.EnsureThirdPerson(existing2);
                            await DbContext.Speakers.AddAsync(existing2);
                            await DbContext.SaveChangesAsync();
                            speakers = await DbContext.Speakers.OrderBy(sp => sp.Name).ToListAsync();
                        }
                        session2SpeakerId = existing2.Id.ToString();
                    }
                }

                statusMessage = $"Successfully imported {sessionsList.Count} session(s) from Sessionize!";
                isError = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sessionize sync failed.");
            statusMessage = $"Failed to sync from Sessionize: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSyncingSessionize = false;
        }
    }

    private async Task GenerateMagicLinkAsync(int slot)
    {
        var session = slot == 0 ? session1 : session2;
        try
        {
            var speakerIdText = slot == 0 ? session1SpeakerId : session2SpeakerId;
            if (!Guid.TryParse(speakerIdText, out _))
            {
                var placeholder = new Speaker { Name = Speaker.PlaceholderName };
                await DbContext.Speakers.AddAsync(placeholder);
                speakers?.Add(placeholder);
                if (slot == 0) session1SpeakerId = placeholder.Id.ToString();
                else session2SpeakerId = placeholder.Id.ToString();
            }

            if (!await PersistEventAsync(navigateIfNew: false)) return;

            var baseUrl = NavManager.BaseUri.TrimEnd('/');
            var (rawToken, _) = await MagicLinkService.CreateTokenAsync(session.SpeakerId, session.Id);
            var url = $"{baseUrl}/speaker/submit/{rawToken}";

            if (slot == 0)
                magicLinkUrl1 = url;
            else
                magicLinkUrl2 = url;

            copiedLink = null;
            statusMessage = "Magic link generated (any previous unused link was revoked). Click 'Copy' to share it with the speaker.";
            isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate magic link.");
            statusMessage = $"Failed to generate magic link: {ex.Message}";
            isError = true;
        }
    }

    private async Task CopyToClipboardAsync(string text)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("meetupOrganiser.copyText", text);
            if (ok)
            {
                copiedLink = text;
                statusMessage = null;
            }
            else
            {
                statusMessage = "Couldn't copy automatically. Select the link and press Ctrl+C.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Clipboard copy failed.");
            statusMessage = "Couldn't copy automatically. Select the link and press Ctrl+C.";
            isError = true;
        }
    }

    private void OnLinkEmailed(string speakerId, string address)
    {
        if (SelectedSpeaker(speakerId) is { } sp && string.IsNullOrWhiteSpace(sp.Email))
            sp.Email = address;
    }

