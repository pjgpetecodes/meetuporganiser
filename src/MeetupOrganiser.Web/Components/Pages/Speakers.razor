@page "/speakers"
@attribute [Authorize]
@using MeetupOrganiser.Core.Entities
@using MeetupOrganiser.Core.Services
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject NavigationManager NavManager
@using MeetupOrganiser.Core.DTOs
@inject IBlobStorageService BlobStorageService
@inject ISessionizeService SessionizeService
@inject ISettingsService SettingsService
@inject ILogger<Speakers> Logger

<PageTitle>Speaker Directory - Meetup Organiser</PageTitle>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Speaker Directory</h1>
            <p class="text-secondary mb-0">Save speaker bios, photos, and socials to reuse across future events.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-info" @onclick="ToggleBulkImportAsync">
                <i class="bi bi-cloud-arrow-down me-1"></i> Import from Sessionize
            </button>
            <a class="btn btn-primary" href="/speakers/new">
                <i class="bi bi-person-plus me-1"></i> Add Speaker
            </a>
        </div>
    </div>

    @if (showBulkImport)
    {
        <div class="card border-0 shadow-sm p-3 mb-4">
            <div class="fw-semibold mb-2"><i class="bi bi-cloud-arrow-down me-2 text-info"></i>Import all speakers from Sessionize</div>
            <div class="input-group">
                <input @bind="sessionizeEventId" class="form-control" placeholder="Sessionize API ID or Speakers endpoint URL" />
                <button class="btn btn-info" @onclick="ImportAllFromSessionizeAsync" disabled="@isLoadingSessionize">
                    @if (isLoadingSessionize)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Import All
                </button>
            </div>
            <div class="form-text">New speakers are added. Existing speakers (matched by name) only have blank fields filled in.</div>
        </div>
    }

    @if (statusMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@statusMessage</div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm p-3 mb-4">
        <div class="row g-2">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search by name, bio, or email..." @bind="searchQuery" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>

    @if (filteredSpeakers == null)
    {
        @if (statusMessage == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">The speaker directory could not be loaded.</div>
        }
    }
    else if (!filteredSpeakers.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-person-badge text-secondary display-4 mb-3"></i>
            <h4 class="fw-bold">No Speakers Found</h4>
            <p class="text-secondary">Add speakers to your directory to easily assign them to upcoming meetups.</p>
            <div>
                <a class="btn btn-primary" href="/speakers/new">Add New Speaker</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var sp in filteredSpeakers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <a href="/speakers/edit/@sp.Id" class="text-decoration-none" title="Edit @sp.Name">
                                @if (!string.IsNullOrWhiteSpace(sp.PhotoBlobUrl))
                                {
                                    <img src="@sp.PhotoBlobUrl" alt="@sp.Name" class="rounded-circle border" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary-subtle text-primary border d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 60px; height: 60px;">
                                        @sp.Name[..Math.Min(2, sp.Name.Length)]
                                    </div>
                                }
                            </a>
                            <div>
                                <h5 class="fw-bold mb-0"><a href="/speakers/edit/@sp.Id" class="text-reset text-decoration-none" title="Edit @sp.Name">@sp.Name</a></h5>
                                @if (!string.IsNullOrWhiteSpace(sp.Email))
                                {
                                    <div class="small text-secondary">@sp.Email</div>
                                }
                            </div>
                        </div>

                        <p class="text-secondary small mb-3 flex-grow-1">
                            @(string.IsNullOrWhiteSpace(sp.Bio) ? "No bio provided." : (sp.Bio.Length > 120 ? sp.Bio[..117] + "..." : sp.Bio))
                        </p>

                        <!-- Social Chips -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (!string.IsNullOrWhiteSpace(sp.LinkedInUrl))
                            {
                                <a href="@sp.LinkedInUrl" target="_blank" class="badge bg-primary-subtle text-primary text-decoration-none border border-primary-subtle">
                                    <i class="bi bi-linkedin me-1"></i> LinkedIn
                                </a>
                            }
                            @if (SocialLinks.BlueSkyUrl(sp.BlueSkyHandle) is { } blueSkyUrl)
                            {
                                <a href="@blueSkyUrl" target="_blank" rel="noopener noreferrer" class="badge bg-info-subtle text-info text-decoration-none border border-info-subtle">
                                    <i class="bi bi-cloud me-1"></i> @SocialLinks.BlueSkyHandle(sp.BlueSkyHandle)
                                </a>
                            }
                            @if (SocialLinks.XUrl(sp.TwitterHandle) is { } xUrl)
                            {
                                <a href="@xUrl" target="_blank" rel="noopener noreferrer" class="badge bg-dark-subtle text-dark text-decoration-none border border-dark-subtle">
                                    <i class="bi bi-twitter-x me-1"></i> @SocialLinks.XHandle(sp.TwitterHandle)
                                </a>
                            }
                            @if (SocialLinks.WebUrl(sp.FacebookUrl) is { } facebookUrl)
                            {
                                <a href="@facebookUrl" target="_blank" rel="noopener noreferrer" class="badge bg-primary-subtle text-primary text-decoration-none border border-primary-subtle">
                                    <i class="bi bi-facebook me-1"></i> Facebook
                                </a>
                            }
                            @if (SocialLinks.WebUrl(sp.WebsiteUrl) is { } websiteUrl)
                            {
                                <a href="@websiteUrl" target="_blank" rel="noopener noreferrer" class="badge bg-success-subtle text-success text-decoration-none border border-success-subtle">
                                    <i class="bi bi-globe me-1"></i> Website
                                </a>
                            }
                            @if (SocialLinks.GitHubUrl(sp.GitHubHandle) is { } githubUrl)
                            {
                                <a href="@githubUrl" target="_blank" rel="noopener noreferrer" class="badge bg-secondary-subtle text-secondary text-decoration-none border border-secondary-subtle">
                                    <i class="bi bi-github me-1"></i> @SocialLinks.GitHubLabel(sp.GitHubHandle)
                                </a>
                            }
                        </div>

                        <!-- Past Sessions Count -->
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="badge bg-light text-secondary border">
                                @sp.Sessions.Count Talk(s)
                            </span>
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" href="/speakers/edit/@sp.Id">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <button class="btn btn-outline-danger" @onclick="() => DeleteSpeakerAsync(sp)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private ConfirmDialog? confirmDialog;
    private List<Speaker>? allSpeakers;
    private string searchQuery = string.Empty;
    private string? statusMessage;
    private bool isError;

    private IEnumerable<Speaker>? filteredSpeakers => string.IsNullOrWhiteSpace(searchQuery)
        ? allSpeakers
        : allSpeakers?.Where(s => s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                 (s.Bio != null && s.Bio.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                                 (s.Email != null && s.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadSpeakersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the speaker directory.");
            statusMessage = "Unable to load the speaker directory. The error has been logged.";
            isError = true;
        }
    }

    private async Task LoadSpeakersAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        allSpeakers = await dbContext.Speakers
            .Include(s => s.Sessions)
            .OrderBy(s => s.Name)
            .ToListAsync();
    }

    private string sessionizeEventId = string.Empty;
    private bool isLoadingSessionize;

    private bool showBulkImport;

    private async Task ToggleBulkImportAsync()
    {
        showBulkImport = !showBulkImport;
        if (showBulkImport && string.IsNullOrWhiteSpace(sessionizeEventId))
        {
            try
            {
                sessionizeEventId = await SettingsService.GetSettingAsync("Integrations:Sessionize:DefaultEventId") ?? string.Empty;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not read the default Sessionize event ID.");
            }
        }
    }

    private async Task ImportAllFromSessionizeAsync()
    {
        if (string.IsNullOrWhiteSpace(sessionizeEventId))
        {
            statusMessage = "Enter a Sessionize API ID first.";
            isError = true;
            return;
        }

        isLoadingSessionize = true;
        try
        {
            var imported = await SessionizeService.GetSpeakersAsync(sessionizeEventId.Trim());
            if (imported.Count == 0)
            {
                statusMessage = "No speakers were returned. Check the API ID and that the Speakers endpoint is enabled.";
                isError = true;
                return;
            }

            var added = 0;
            var updated = 0;
            await using (var dbContext = await DbContextFactory.CreateDbContextAsync())
            {
                var known = await dbContext.Speakers.ToListAsync();
                foreach (var source in imported)
                {
                    var candidate = new Speaker();
                    SessionizeSpeakerMapper.Apply(candidate, source);
                    if (string.IsNullOrWhiteSpace(candidate.Name)) continue;

                    var existing = known.FirstOrDefault(s => string.Equals(s.Name, candidate.Name, StringComparison.OrdinalIgnoreCase));
                    if (existing == null)
                    {
                        candidate.Id = Guid.NewGuid();
                        candidate.CreatedAtUtc = DateTime.UtcNow;
                        candidate.UpdatedAtUtc = DateTime.UtcNow;
                        await dbContext.Speakers.AddAsync(candidate);
                        known.Add(candidate);
                        added++;
                        continue;
                    }

                    var changed = false;
                    changed |= FillIfBlank(existing.Bio, candidate.Bio, v => { existing.Bio = v; existing.BioThirdPerson = candidate.BioThirdPerson; });
                    changed |= FillIfBlank(existing.Pronouns, candidate.Pronouns, v => existing.Pronouns = v);
                    changed |= FillIfBlank(existing.PhotoBlobUrl, candidate.PhotoBlobUrl, v => existing.PhotoBlobUrl = v);
                    changed |= FillIfBlank(existing.LinkedInUrl, candidate.LinkedInUrl, v => existing.LinkedInUrl = v);
                    changed |= FillIfBlank(existing.TwitterHandle, candidate.TwitterHandle, v => existing.TwitterHandle = v);
                    changed |= FillIfBlank(existing.BlueSkyHandle, candidate.BlueSkyHandle, v => existing.BlueSkyHandle = v);
                    changed |= FillIfBlank(existing.GitHubHandle, candidate.GitHubHandle, v => existing.GitHubHandle = v);
                    changed |= FillIfBlank(existing.WebsiteUrl, candidate.WebsiteUrl, v => existing.WebsiteUrl = v);
                    changed |= FillIfBlank(existing.FacebookUrl, candidate.FacebookUrl, v => existing.FacebookUrl = v);
                    if (changed)
                    {
                        existing.UpdatedAtUtc = DateTime.UtcNow;
                        updated++;
                    }
                }

                await dbContext.SaveChangesAsync();
            }

            await LoadSpeakersAsync();
            statusMessage = $"Sessionize import complete: {added} added, {updated} updated.";
            isError = false;
            showBulkImport = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bulk Sessionize speaker import failed.");
            statusMessage = "Unable to import speakers from Sessionize. The error has been logged.";
            isError = true;
        }
        finally
        {
            isLoadingSessionize = false;
        }
    }

    private static bool FillIfBlank(string? current, string? incoming, Action<string> assign)
    {
        if (!string.IsNullOrWhiteSpace(current) || string.IsNullOrWhiteSpace(incoming)) return false;
        assign(incoming);
        return true;
    }

    private async Task DeleteSpeakerAsync(Speaker speaker)
    {
        if (!await confirmDialog!.ShowAsync($"Delete speaker \"{speaker.Name}\"? This cannot be undone.", "Delete speaker?")) return;

        try
        {
            await using (var dbContext = await DbContextFactory.CreateDbContextAsync())
            {
                var hasSessions = await dbContext.EventSpeakerSessions.AnyAsync(s => s.SpeakerId == speaker.Id);
                if (hasSessions)
                {
                    statusMessage = "This speaker is linked to an event session and cannot be deleted.";
                    isError = true;
                    return;
                }

                var speakerToDelete = await dbContext.Speakers.FindAsync(speaker.Id);
                if (speakerToDelete == null) return;

                dbContext.Speakers.Remove(speakerToDelete);
                await dbContext.SaveChangesAsync();
            }

            statusMessage = "Speaker deleted.";
            isError = false;
            await LoadSpeakersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete speaker {SpeakerId}.", speaker.Id);
            statusMessage = "Unable to delete the speaker. The error has been logged.";
            isError = true;
        }
    }
}
