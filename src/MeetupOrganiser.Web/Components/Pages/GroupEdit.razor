@page "/groups/new"
@page "/groups/edit/{Id:guid}"
@attribute [Authorize]
@using MeetupOrganiser.Core.Entities
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Core.Services
@using MeetupOrganiser.Infrastructure.Data
@using MeetupOrganiser.Infrastructure.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IPptxPreviewService PreviewService
@inject IBlobStorageService BlobStorageService
@inject NavigationManager NavManager
@inject ILogger<GroupEdit> Logger

<PageTitle>@(IsNew ? "New Group" : "Edit Group") - Meetup Organiser</PageTitle>

<div class="container-fluid py-2 group-edit-page">
    <div class="d-flex justify-content-between align-items-center mb-4 page-heading">
        <div>
            <h1 class="h3 fw-bold mb-1">@(IsNew ? "Create Meetup Group" : "Edit Meetup Group")</h1>
            <p class="text-secondary mb-0">Configure branding, social post template, logo and presentation template.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/groups" class="btn btn-outline-secondary">Back to Groups</a>
            <button type="button" class="btn btn-primary" @onclick="SaveGroupAsync" disabled="@(saving || group == null)">
                @if (saving) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
                <i class="bi bi-check-circle me-1"></i> Save Group
            </button>
        </div>
    </div>

    @if (statusMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (group == null)
    {
        @if (statusMessage == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">The group editor could not be loaded. Use <a href="/groups">Back to Groups</a> to return to the list.</div>
        }
    }
    else
    {
        <ul class="nav nav-tabs mb-4 page-tabs">
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "details" ? "active" : "")" @onclick='() => activeTab = "details"'><i class="bi bi-people me-1"></i> Group Details</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "meetup" ? "active" : "")" @onclick='() => activeTab = "meetup"'><i class="bi bi-calendar-check me-1"></i> Meetup</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "social" ? "active" : "")" @onclick='() => activeTab = "social"'><i class="bi bi-share me-1"></i> Social</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "sponsors" ? "active" : "")" @onclick='() => activeTab = "sponsors"'><i class="bi bi-award me-1"></i> Sponsors <span class="badge bg-secondary">@group.Sponsors.Count</span></button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "pptx" ? "active" : "")" @onclick='() => activeTab = "pptx"'><i class="bi bi-file-earmark-slides me-1"></i> Custom PPTX Template</button>
            </li>
        </ul>

        <div class="row g-4">
            <div class="col-12 @(activeTab == "details" ? "" : "d-none")">
                <div class="card border-0 shadow-sm p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-people me-2 text-primary"></i>Group Details</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Group Name *</label>
                            <input @bind="group.Name" class="form-control" placeholder="e.g. .NET Notts" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Website URL</label>
                            <input @bind="group.WebsiteUrl" class="form-control" placeholder="https://..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description / Tagline</label>
                            <textarea @bind="group.Description" class="form-control" rows="2" placeholder="Talks from the world of Microsoft and beyond"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Primary Brand Color (Hex)</label>
                            <div class="input-group">
                                <input type="color" @bind="group.PrimaryColorHex" class="form-control form-control-color" style="max-width: 60px;" />
                                <input type="text" @bind="group.PrimaryColorHex" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Secondary Brand Color (Hex)</label>
                            <div class="input-group">
                                <input type="color" @bind="group.SecondaryColorHex" class="form-control form-control-color" style="max-width: 60px;" />
                                <input type="text" @bind="group.SecondaryColorHex" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Default Location</label>
                            <input @bind="group.DefaultLocation" class="form-control" placeholder="e.g. CGI, Nottingham & Online On Zoom" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Organiser Email</label>
                            <input type="email" @bind="group.OrganiserEmail" class="form-control" placeholder="organiser@example.com" />
                            <small class="text-secondary">Notified when a speaker completes their magic-link form. Leave blank to use the address in Settings.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Default Hashtags</label>
                            <input @bind="group.DefaultHashtags" class="form-control" placeholder="#dotnet #dotnetnotts #azure" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Group Logo (Optional)</label>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(group.LogoBlobUrl))
                                {
                                    <img src="@group.LogoBlobUrl" alt="Logo preview" class="rounded border" style="width: 64px; height: 64px; object-fit: cover;" />
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => group.LogoBlobUrl = null">Remove</button>
                                }
                                <InputFile OnChange="HandleLogoUploadAsync" class="form-control" accept=".png,.jpg,.jpeg,.webp" />
                            </div>
                            <small class="text-secondary">PNG, JPG or WebP, up to 2 MB. Click Save Group to keep it.</small>
                            @if (!string.IsNullOrEmpty(logoError))
                            {
                                <div class="text-danger small">@logoError</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 @(activeTab == "meetup" ? "" : "d-none")">
                <div class="card border-0 shadow-sm p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-calendar-check me-2 text-danger"></i>Meetup</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Meetup Group Slug (urlname)</label>
                            <input @bind="group.MeetupUrlName" class="form-control" placeholder="e.g. dotnetnotts" />
                            <small class="text-secondary">Used in meetup.com/{urlname}/events</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Meetup API Key Override (Optional)</label>
                            <input type="password" @bind="group.MeetupApiKeyOverride" class="form-control" placeholder="Leave blank to use global API key" />
                            <small class="text-secondary">Only needed if this group is under a different Meetup account.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Speaker Bios</label>
                            <select class="form-select" @bind="group.BioPreference">
                                <option value="">Use global setting</option>
                                <option value="@SpeakerBio.ThirdPerson">Third person (recommended)</option>
                                <option value="@SpeakerBio.Original">Original, as written by the speaker</option>
                            </select>
                            <small class="text-secondary">Overrides the Settings page for this group's descriptions.</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Meetup Description Template</label>
                            <textarea class="form-control font-monospace small mb-2" rows="14" @bind="group.MeetupDescriptionTemplate" placeholder="Leave blank to use the global template from Settings"></textarea>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var (name, description) in MeetupDescriptionTemplate.Placeholders)
                                {
                                    <code title="@description" class="small">{{@name}}</code>
                                }
                            </div>
                            <small class="text-secondary">Hover a placeholder for what it does.</small>
                            <div><button type="button" class="btn btn-sm btn-link p-0" @onclick="() => group.MeetupDescriptionTemplate = MeetupDescriptionTemplate.Default">Start from the built-in default</button></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 @(activeTab == "social" ? "" : "d-none")">
                <div class="card border-0 shadow-sm p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-share me-2 text-primary"></i>Social</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Short URL Stem (Bitly)</label>
                            <input @bind="group.ShortUrlStem" class="form-control" placeholder="https://bit.ly/dotnetnotts" />
                            <small class="text-secondary">Month and year are added per event, e.g. https://bit.ly/dotnetnottsoctober2026</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Social Post Template</label>
                            <textarea @bind="group.SocialPostTemplate" class="form-control font-monospace small" rows="8" placeholder="Leave blank to use the built-in template"></textarea>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var (name, description) in SocialPostFormatter.Placeholders)
                                {
                                    <code title="@description" class="small">{{@name}}</code>
                                }
                            </div>
                            <small class="text-secondary">Used for X, Bluesky and LinkedIn posts. Hover a placeholder for what it does.</small>
                            <div><button type="button" class="btn btn-sm btn-link p-0" @onclick="() => group.SocialPostTemplate = SocialPostFormatter.Default">Reset to default</button></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 @(activeTab == "sponsors" ? "" : "d-none")">
                <div class="card border-0 shadow-sm p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0"><i class="bi bi-award me-2 text-warning"></i>Sponsors</h5>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="AddSponsor"><i class="bi bi-plus-lg me-1"></i> Add Sponsor</button>
                    </div>
                    <p class="text-secondary small">Use <code>{{Sponsors}}</code> (mentions, e.g. @@handle) or <code>{{SponsorNames}}</code> in the Social Post Template to include them. Click Save Group to keep changes.</p>
                    @if (group.Sponsors.Count == 0)
                    {
                        <div class="text-secondary">No sponsors yet.</div>
                    }
                    <div class="d-flex flex-column gap-3">
                        @foreach (var sponsor in group.Sponsors)
                        {
                            <div class="border rounded p-3" @key="sponsor.Id">
                                <div class="row g-3 align-items-start">
                                    <div class="col-md-2 text-center">
                                        @if (!string.IsNullOrWhiteSpace(sponsor.LogoBlobUrl))
                                        {
                                            <img src="@sponsor.LogoBlobUrl" alt="@sponsor.Name logo" class="rounded border bg-light mb-2" style="max-width: 100%; max-height: 80px; object-fit: contain;" />
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100 mb-2" @onclick="() => sponsor.LogoBlobUrl = null">Remove logo</button>
                                        }
                                        <InputFile OnChange="e => HandleSponsorLogoAsync(sponsor, e)" class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.webp" />
                                    </div>
                                    <div class="col-md-10">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold mb-0">Name *</label>
                                                <input @bind="sponsor.Name" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold mb-0">Website</label>
                                                <input @bind="sponsor.WebsiteUrl" class="form-control form-control-sm" placeholder="https://..." />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold mb-0"><i class="bi bi-twitter-x me-1"></i>X handle</label>
                                                <input @bind="sponsor.TwitterHandle" class="form-control form-control-sm" placeholder="@@handle" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold mb-0"><i class="bi bi-cloud-sun me-1"></i>BlueSky handle</label>
                                                <input @bind="sponsor.BlueSkyHandle" class="form-control form-control-sm" placeholder="name.bsky.social" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold mb-0"><i class="bi bi-linkedin me-1"></i>LinkedIn URL</label>
                                                <input @bind="sponsor.LinkedInUrl" class="form-control form-control-sm" placeholder="https://linkedin.com/company/..." />
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 mt-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CopySponsor(sponsor)"><i class="bi bi-files me-1"></i> Copy</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSponsorAsync(sponsor)"><i class="bi bi-trash me-1"></i> Delete</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(sponsorError))
                    {
                        <div class="text-danger small mt-2">@sponsorError</div>
                    }
                </div>
            </div>

            <div class="col-12 @(activeTab == "pptx" ? "" : "d-none")">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-file-earmark-slides me-2 text-primary"></i>Custom PPTX Template (Optional)</h5>
                    <InputFile OnChange="HandleTemplateUploadAsync" class="form-control" accept=".pptx" disabled="@(templateUploading || slidesLoading)" />
                    @if (templateUploading || slidesLoading)
                    {
                        <div class="d-flex align-items-center gap-2 text-secondary small mt-2" role="status">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>@(templateUploading ? "Uploading and processing your deck... please wait." : "Rendering slide previews... please wait.")</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(templateError))
                    {
                        <div class="text-danger small">@templateError</div>
                    }
                    <small class="text-secondary d-block">Upload a full deck with <code>{{placeholders}}</code> on the slides to fill (e.g. {{SpeakerName}}, {{TalkTitle}}, {{Speaker2Name}}, {{Talk2Title}}, {{EventDateLine}}, {{EventVenueLine}}, {{EventSubtitle}}, {{ShortUrl}}). Next-event versions use a NextEvent prefix (e.g. {{NextEventSpeakers}}, {{NextEventTalkTitle}}, {{NextEventDate}}) and show TBC until the next event exists. Slides with placeholders are filled; slides using {{Speaker2Name}}/{{Talk2Title}} are hidden for 1-speaker events and speaker-1-only slides are hidden for 2-speaker events.                     other slides are left as uploaded. Slides using only NextEvent tokens follow the next event: they are hidden when there is no next event, and {{NextEventSpeaker2Name}}/{{NextEventTalk2Title}} slides are used only for 2-speaker next events (set picture alt text to <code>{{NextEventSpeaker1Photo}}</code> / <code>{{NextEventSpeaker2Photo}}</code> to place the next speakers' headshots). Leave a token off a slide to leave that text alone. To place speaker headshots, set a picture's alt text (Format Picture &gt; Alt Text) to <code>{{Speaker1Photo}}</code> or <code>{{Speaker2Photo}}</code>; without those markers the large square pictures on speaker slides are used. Fonts that aren't installed on the server fall back to a default unless the .ttf is added to Resources/fonts (Baloo 2 is bundled). Re-upload if the preview isn't right.</small>

                    @if (TemplateFileName is { } templateFile && !templateUploading)
                    {
                        @if (slidesLoading)
                        {
                            <div class="text-secondary small mt-2">Reading slides...</div>
                        }
                        else if (slides.Count == 0)
                        {
                            <div class="text-warning small mt-2">Could not read any slides from this deck.</div>
                        }
                        else
                        {
                            @if (!slides.Any(s => s.Tokens.Count > 0))
                            {
                                <div class="alert alert-warning py-2 small mt-2 mb-2">
                                    No {{placeholders}} found in this deck, so the built-in deck will be used. Add placeholders and re-upload.
                                </div>
                            }

                            <div class="btn-group btn-group-sm mt-2" role="group">
                                <button type="button" class="btn @(previewSpeakers == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => previewSpeakers = 1">Preview 1 speaker</button>
                                <button type="button" class="btn @(previewSpeakers == 2 ? "btn-primary" : "btn-outline-primary")" @onclick="() => previewSpeakers = 2">Preview 2 speakers</button>
                            </div>

                            <div class="d-flex flex-wrap gap-2 py-2">
                                @foreach (var s in slides.Where(x => !IsHidden(x)))
                                {
                                    var filled = s.Tokens.Count > 0;
                                    var hidden = false;
                                    <div class="card template-slide-card" style="width: 300px; @(!filled || hidden ? "opacity:.45;" : "")">
                                        @if (filled)
                                        {
                                            <img src="/api/templates/@Uri.EscapeDataString(templateFile)/slides/@s.Number/filled.png?speakers=@previewSpeakers&w=600" class="card-img-top template-slide-preview" loading="lazy" alt="Slide @s.Number" />
                                        }
                                        else
                                        {
                                            <img src="/api/templates/@Uri.EscapeDataString(templateFile)/slides/@(s.Number).png?w=600" class="card-img-top template-slide-preview" loading="lazy" alt="Slide @s.Number" style="filter: grayscale(1);" />
                                        }
                                        <div class="card-body p-2">
                                            <div class="small fw-semibold text-truncate" title="@s.Caption">@s.Number. @s.Caption</div>
                                            <div class="text-secondary" style="font-size: .7rem;">
                                                @(filled ? $"{s.Tokens.Count} placeholder(s) filled" : "No placeholders - unchanged")
                                                @if (filled) { <span> · @KindLabel(s.Kind)</span> }
                                                @if (hidden) { <span class="badge bg-secondary ms-1">Hidden</span> }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="text-secondary" style="font-size: .7rem;">Approximate preview with sample data; PowerPoint will look slightly different.</div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 page-actions">
            <a href="/groups" class="btn btn-secondary">Cancel</a>
            <button type="button" class="btn btn-primary" @onclick="SaveGroupAsync" disabled="@saving">Save Group</button>
        </div>
    }
</div>

<style>
    .group-edit-page .page-heading { gap: 1rem; }
    .group-edit-page .page-heading > div:last-child { flex-wrap: wrap; }
    .group-edit-page .page-tabs { flex-wrap: wrap; }
    .group-edit-page .nav-link { white-space: nowrap; }
    .group-edit-page .input-group { min-width: 0; }
    .group-edit-page .input-group > .form-control { min-width: 0; }
    .group-edit-page .template-slide-card { flex: 0 1 300px; max-width: 100%; }
    .group-edit-page .template-slide-preview { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; background: #f8f9fa; }
    @@media (max-width: 575.98px) {
        .group-edit-page .page-heading { align-items: stretch !important; }
        .group-edit-page .page-heading > div:last-child { display: grid !important; grid-template-columns: 1fr; }
        .group-edit-page .page-heading > div:last-child .btn { width: 100%; }
        .group-edit-page .card { padding: 1rem !important; }
        .group-edit-page .page-tabs { gap: .25rem; }
        .group-edit-page .page-tabs .nav-link { padding: .45rem .6rem; }
        .group-edit-page .input-group { flex-wrap: wrap; }
        .group-edit-page .input-group > .form-control { flex: 1 1 100%; width: 100%; border-radius: var(--bs-border-radius) !important; }
        .group-edit-page .input-group > .btn { flex: 1 1 100%; width: 100%; border-radius: var(--bs-border-radius) !important; }
        .group-edit-page .page-actions { display: grid !important; grid-template-columns: 1fr; }
        .group-edit-page .page-actions .btn { width: 100%; }
        .group-edit-page .template-slide-card { flex-basis: min(100%, 300px); }
    }
</style>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private ConfirmDialog? confirmDialog;
    [Parameter] public Guid? Id { get; set; }

    private MeetupGroup? group;
    private string? statusMessage;
    private bool isError;
    private bool saving;
    private string activeTab = "details";
    private bool IsNew => Id == null;

    protected override async Task OnParametersSetAsync()
    {
        statusMessage = null;
        group = null;
        slides = [];

        if (IsNew)
        {
            group = new MeetupGroup
            {
                Id = Guid.Empty,
                PrimaryColorHex = "#512BD4",
                SecondaryColorHex = "#0078D4",
                DefaultLocation = "Online on Zoom",
                DefaultHashtags = "#dotnet #meetup",
                MeetupUrlName = "dotnetnotts"
            };
            return;
        }

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            group = await db.MeetupGroups.AsNoTracking().Include(g => g.Sponsors).FirstOrDefaultAsync(g => g.Id == Id);
            group?.Sponsors.Sort((a, b) => a.SortOrder.CompareTo(b.SortOrder));
            if (group == null)
            {
                statusMessage = "That meetup group was not found.";
                isError = true;
                return;
            }

            await LoadSlidesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load group {GroupId}.", Id);
            statusMessage = "Could not load the group: " + ex.Message;
            isError = true;
        }
    }

    private IReadOnlyList<PptxSlideInfo> slides = [];
    private bool slidesLoading;
    private int previewSpeakers = 1;

    private string? TemplateFileName =>
        PptxTemplateStore.TryParseFileName(group?.PptxTemplateBlobUrl, out var name) ? name : null;

    private async Task LoadSlidesAsync()
    {
        if (TemplateFileName is not { } name) { slides = []; return; }

        slidesLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            slides = await PreviewService.GetSlidesAsync(name);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read template slides.");
            slides = [];
        }
        finally
        {
            slidesLoading = false;
        }
    }

    private static string KindLabel(PptxTokens.SlideKind kind) => kind switch
    {
        PptxTokens.SlideKind.OneSpeaker => "1-speaker slide",
        PptxTokens.SlideKind.TwoSpeakers => "2-speaker slide",
        _ => "Always shown"
    };

    private bool IsHidden(PptxSlideInfo s)
    {
        var twoExist = slides.Any(x => x.NextEventOnly == s.NextEventOnly && x.Kind == PptxTokens.SlideKind.TwoSpeakers);
        return previewSpeakers > 1
            ? s.Kind == PptxTokens.SlideKind.OneSpeaker && twoExist
            : s.Kind == PptxTokens.SlideKind.TwoSpeakers;
    }

    private string? logoError;
    private string? sponsorError;

    private void AddSponsor() =>
        group!.Sponsors.Add(new Sponsor { Name = "New Sponsor", SortOrder = group.Sponsors.Count });

    private async Task DeleteSponsorAsync(Sponsor sponsor)
    {
        var name = string.IsNullOrWhiteSpace(sponsor.Name) ? "this sponsor" : $"\"{sponsor.Name}\"";
        if (await confirmDialog!.ShowAsync($"Delete {name}? It is removed when you save the group.", "Delete sponsor?")) group.Sponsors.Remove(sponsor);
    }

    private void CopySponsor(Sponsor source)
    {
        var index = group!.Sponsors.IndexOf(source);
        group.Sponsors.Insert(index + 1, new Sponsor
        {
            Name = source.Name + " (copy)",
            LogoBlobUrl = source.LogoBlobUrl,
            WebsiteUrl = source.WebsiteUrl,
            TwitterHandle = source.TwitterHandle,
            BlueSkyHandle = source.BlueSkyHandle,
            LinkedInUrl = source.LinkedInUrl
        });
    }

    private async Task HandleSponsorLogoAsync(Sponsor sponsor, InputFileChangeEventArgs e)
    {
        sponsorError = null;
        var file = e.File;
        if (file == null) return;

        if (!LogoTypes.TryGetValue(Path.GetExtension(file.Name), out var contentType))
        {
            sponsorError = "Please choose a PNG, JPG or WebP image.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            sponsor.LogoBlobUrl = await BlobStorageService.UploadAsync("logos", file.Name, stream, contentType);
        }
        catch (IOException)
        {
            sponsorError = "That file is larger than 2 MB.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to upload sponsor logo.");
            sponsorError = "Logo upload failed. Please try again.";
        }
    }

    private static readonly Dictionary<string, string> LogoTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        [".png"] = "image/png",
        [".jpg"] = "image/jpeg",
        [".jpeg"] = "image/jpeg",
        [".webp"] = "image/webp"
    };

    private async Task HandleLogoUploadAsync(InputFileChangeEventArgs e)
    {
        logoError = null;
        var file = e.File;
        if (file == null || group == null) return;

        if (!LogoTypes.TryGetValue(Path.GetExtension(file.Name), out var contentType))
        {
            logoError = "Please choose a PNG, JPG or WebP image.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            group.LogoBlobUrl = await BlobStorageService.UploadAsync("logos", file.Name, stream, contentType);
        }
        catch (IOException)
        {
            logoError = "That file is larger than 2 MB.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to upload group logo.");
            logoError = "Logo upload failed. Please try again.";
        }
    }

    private string? templateError;
    private bool templateUploading;

    private async Task HandleTemplateUploadAsync(InputFileChangeEventArgs e)
    {
        templateError = null;
        var file = e.File;
        if (file == null || group == null) return;

        templateUploading = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            using var stream = file.OpenReadStream(100 * 1024 * 1024);
            group.PptxTemplateBlobUrl = await BlobStorageService.UploadAsync("templates", file.Name, stream, "application/vnd.openxmlformats-officedocument.presentationml.presentation");
            await LoadSlidesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to upload PPTX template.");
            templateError = ex is IOException
                ? "That file is larger than 100 MB."
                : "Template upload failed: " + ex.Message;
        }
        finally
        {
            templateUploading = false;
        }
    }

    private async Task SaveGroupAsync()
    {
        if (group == null) return;
        if (string.IsNullOrWhiteSpace(group.Name))
        {
            statusMessage = "Group name is required.";
            isError = true;
            return;
        }

        saving = true;
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var social = string.IsNullOrWhiteSpace(group.SocialPostTemplate) ? null : group.SocialPostTemplate;
            var descriptionTemplate = string.IsNullOrWhiteSpace(group.MeetupDescriptionTemplate) ? null : group.MeetupDescriptionTemplate;
            group.BioPreference = string.IsNullOrWhiteSpace(group.BioPreference) ? null : group.BioPreference;

            if (IsNew)
            {
                group.Id = Guid.NewGuid();
                group.SocialPostTemplate = social;
                group.MeetupDescriptionTemplate = descriptionTemplate;
                group.CreatedAtUtc = DateTime.UtcNow;
                group.UpdatedAtUtc = DateTime.UtcNow;
                db.MeetupGroups.Add(group);
            }
            else
            {
                var existing = await db.MeetupGroups.Include(g => g.Sponsors).FirstOrDefaultAsync(g => g.Id == group.Id);
                if (existing == null)
                {
                    statusMessage = "That meetup group no longer exists.";
                    isError = true;
                    return;
                }

                existing.Name = group.Name;
                existing.Description = group.Description;
                existing.WebsiteUrl = group.WebsiteUrl;
                existing.PrimaryColorHex = group.PrimaryColorHex;
                existing.SecondaryColorHex = group.SecondaryColorHex;
                existing.DefaultLocation = group.DefaultLocation;
                existing.OrganiserEmail = group.OrganiserEmail;
                existing.DefaultHashtags = group.DefaultHashtags;
                existing.MeetupUrlName = group.MeetupUrlName;
                existing.ShortUrlStem = group.ShortUrlStem;
                existing.SocialPostTemplate = social;
                existing.BioPreference = group.BioPreference;
                existing.MeetupDescriptionTemplate = descriptionTemplate;
                existing.LogoBlobUrl = group.LogoBlobUrl;
                existing.MeetupApiKeyOverride = group.MeetupApiKeyOverride;
                existing.PptxTemplateBlobUrl = group.PptxTemplateBlobUrl;
                foreach (var removed in existing.Sponsors.Where(s => group.Sponsors.All(g => g.Id != s.Id)).ToList())
                {
                    existing.Sponsors.Remove(removed);
                    db.Remove(removed);
                }
                foreach (var edited in group.Sponsors)
                {
                    var target = existing.Sponsors.FirstOrDefault(s => s.Id == edited.Id);
                    if (target == null)
                    {
                        target = new Sponsor { Id = edited.Id, MeetupGroupId = existing.Id };
                        db.Add(target);
                    }
                    target.Name = edited.Name;
                    target.LogoBlobUrl = edited.LogoBlobUrl;
                    target.WebsiteUrl = edited.WebsiteUrl;
                    target.TwitterHandle = edited.TwitterHandle;
                    target.BlueSkyHandle = edited.BlueSkyHandle;
                    target.LinkedInUrl = edited.LinkedInUrl;
                    target.SortOrder = group.Sponsors.IndexOf(edited);
                }
                existing.UpdatedAtUtc = DateTime.UtcNow;
            }

            await db.SaveChangesAsync();
            NavManager.NavigateTo("/groups");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save group.");
            statusMessage = "Could not save the group: " + ex.Message;
            isError = true;
        }
        finally
        {
            saving = false;
        }
    }
}
