@page "/assets"
@attribute [Authorize]
@inject NavigationManager NavManager

@code {
    [SupplyParameterFromQuery]
    public Guid? EventId { get; set; }

    // Social & Slides now lives on a tab of the event editor; keep old links working.
    protected override void OnInitialized() =>
        NavManager.NavigateTo(EventId is { } id ? $"/events/edit/{id}?tab=assets" : "/events", replace: true);
}
