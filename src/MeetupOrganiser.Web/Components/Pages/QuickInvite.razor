@page "/events/invite"
@attribute [Authorize]
@using MeetupOrganiser.Core.Entities
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Core.Services
@using MeetupOrganiser.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IMagicLinkService MagicLinkService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ILogger<QuickInvite> Logger

<PageTitle>Quick Invite - Meetup Organiser</PageTitle>

<div class="container-fluid py-2 quick-invite-page" style="max-width: 860px;">
    <div class="d-flex justify-content-between align-items-center mb-4 page-heading">
        <div>
            <h1 class="h3 fw-bold mb-1">Quick Speaker Invite</h1>
            <p class="text-secondary mb-0">Set the date, place and format, choose your speakers, then send each a link to review their profile and add their talk details.</p>
        </div>
        <a href="/events" class="btn btn-outline-secondary">Back to Events</a>
    </div>

    @if (statusMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@statusMessage</div>
    }

    @if (links.Count == 0)
    {
        <div class="card border-0 shadow-sm p-4">
            <div class="mb-3">
                <label class="form-label fw-semibold">Meetup Group</label>
                <select class="form-select" @bind="groupId">
                    @foreach (var g in groups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Date &amp; Start Time (Local)</label>
                    <input type="datetime-local" class="form-control" @bind="localEventDateTime" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Event Format</label>
                    <select class="form-select" @bind="format">
                        <option value="@EventFormat.Hybrid">Hybrid (in person + Zoom)</option>
                        <option value="@EventFormat.InPerson">In Person only</option>
                        <option value="@EventFormat.Online">Online only (Zoom)</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Venue Name</label>
                    <input type="text" class="form-control" @bind="venueName" disabled="@(format == EventFormat.Online)" />
                </div>
                <div class="col-md-7">
                    <label class="form-label fw-semibold">Location / Platform</label>
                    <input type="text" class="form-control" @bind="location" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold d-block">Speakers</label>
                <div class="btn-group mb-3">
                    <input type="radio" class="btn-check" name="inviteSpeakers" id="inv1" checked="@(speakerCount == 1)" @onchange="() => speakerCount = 1">
                    <label class="btn btn-outline-primary" for="inv1">1 Speaker</label>
                    <input type="radio" class="btn-check" name="inviteSpeakers" id="inv2" checked="@(speakerCount == 2)" @onchange="() => speakerCount = 2">
                    <label class="btn btn-outline-primary" for="inv2">2 Speakers</label>
                </div>
                @for (var s = 0; s < speakerCount; s++)
                {
                    var n = s;
                    <div class="border rounded p-3 mb-3">
                        <div class="form-label fw-semibold">Speaker @(n + 1)</div>
                        <div class="btn-group d-flex mb-3" role="group" aria-label="@($"Speaker {n + 1} source")">
                            @foreach (var mode in Enum.GetValues<SpeakerInviteMode>())
                            {
                                <button type="button" class="btn btn-sm @(speakerModes[n] == mode ? "btn-primary" : "btn-outline-primary")"
                                        aria-pressed="@(speakerModes[n] == mode ? "true" : "false")"
                                        @onclick="() => ChangeSpeakerMode(n, mode)" disabled="@isSaving">
                                    @SpeakerModeLabel(mode)
                                </button>
                            }
                        </div>
                        @if (speakerModes[n] == SpeakerInviteMode.Existing)
                        {
                            <SpeakerPicker Speakers="speakers" @bind-SelectedSpeakerId="selectedSpeakerIds[n]" Disabled="isSaving" />
                        }
                        else
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <input type="text" class="form-control" aria-label="@($"Speaker {n + 1} name")" placeholder="Name (optional)" maxlength="200" @bind="speakerDrafts[n].Name" />
                                </div>
                                <div class="col-md-6">
                                    <input type="email" class="form-control" aria-label="@($"Speaker {n + 1} email")" placeholder="Email (optional)" maxlength="250" @bind="speakerDrafts[n].Email" />
                                </div>
                            </div>
                            @if (speakerModes[n] == SpeakerInviteMode.Import)
                            {
                                <SessionizeProfileLookup Current="speakerDrafts[n]" InitialQuery="@speakerDrafts[n].Name"
                                                         AllowProfileSelection="true" OnApply="result => ApplyProfile(n, result)" />
                            }
                            @if (!string.IsNullOrWhiteSpace(speakerDrafts[n].Bio) || !string.IsNullOrWhiteSpace(speakerDrafts[n].PhotoBlobUrl))
                            {
                                <div class="d-flex align-items-start gap-3 mt-3">
                                    @if (!string.IsNullOrWhiteSpace(speakerDrafts[n].PhotoBlobUrl))
                                    {
                                        <img src="@speakerDrafts[n].PhotoBlobUrl" alt="@speakerDrafts[n].Name" class="rounded-circle" style="width: 64px; height: 64px; object-fit: cover;" />
                                    }
                                    <p class="small mb-0">@speakerDrafts[n].Bio</p>
                                </div>
                            }
                        }
                    </div>
                }
                <div class="form-text">Add an email address to be able to email the link straight to the speaker.</div>
                <div class="form-text">Their profile will be prefilled, and they can edit all their details while submitting their talk.</div>
            </div>

            <div>
                <button type="button" class="btn btn-primary btn-lg" @onclick="CreateInviteAsync" disabled="@isSaving">
                    <i class="bi bi-link-45deg me-1"></i> Create event &amp; speaker links
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-4">
            <p class="mb-3">Draft event <strong>@createdTitle</strong> created. Share each link with its speaker. Each link works once; they can review and edit their prefilled profile and enter their talk details.</p>
            @for (var i = 0; i < links.Count; i++)
            {
                var url = links[i];
                var index = i;
                var label = $"Speaker {i + 1}";
                <div class="mb-3">
                    <label class="form-label fw-semibold">@label</label>
                    <div class="input-group mb-2">
                        <input type="text" readonly class="form-control" value="@url" @onfocus="SelectAllAsync" />
                        <button type="button" class="btn btn-outline-dark" @onclick="() => CopyAsync(url)">@(copiedLink == url ? "Copied!" : "Copy")</button>
                    </div>
                    <EmailLinkForm Link="@url" AutoSend="true" SpeakerId="@speakerIds[index]" SpeakerName="@speakerLabels[index]" InitialEmail="@speakerEmailsSaved[index]"
                                   EventTitle="@createdTitle" EventDateUtc="@createdEventUtc" />
                </div>
            }
            <div class="d-flex gap-2">
                <a href="/events/edit/@createdEventId" class="btn btn-primary">Open event</a>
                <a href="/events" class="btn btn-outline-secondary">Back to Events</a>
            </div>
        </div>
    }
</div>

<style>
    .quick-invite-page .page-heading { gap: 1rem; }
    .quick-invite-page .input-group { min-width: 0; }
    .quick-invite-page .input-group > .form-control { min-width: 0; }
    @@media (max-width: 575.98px) {
        .quick-invite-page .page-heading { align-items: stretch !important; }
        .quick-invite-page .page-heading > a { width: 100%; }
        .quick-invite-page .card { padding: 1rem !important; }
        .quick-invite-page .btn-group { display: flex; width: 100%; }
        .quick-invite-page .btn-group .btn { flex: 1 1 0; }
        .quick-invite-page .input-group { flex-wrap: wrap; gap: .5rem; }
        .quick-invite-page .input-group > .form-control { flex: 1 1 100%; width: 100%; border-radius: var(--bs-border-radius) !important; }
        .quick-invite-page .input-group > .btn { flex: 1 1 100%; width: 100%; border-radius: var(--bs-border-radius) !important; }
        .quick-invite-page .d-flex.gap-2 > .btn { flex: 1 1 100%; }
        .quick-invite-page .d-flex.gap-2 { flex-wrap: wrap; }
    }
</style>

@code {
    private List<MeetupGroup> groups = [];
    private List<Speaker> speakers = [];
    private Guid groupId;
    private DateTime localEventDateTime = DateTime.Now.AddDays(14).Date.AddHours(18).AddMinutes(30);
    private EventFormat format = EventFormat.Hybrid;
    private string? venueName = "CGI";
    private string? location = "CGI, King Street Nottingham & Online";
    private int speakerCount = 1;

    private Guid?[] selectedSpeakerIds = new Guid?[2];
    private Speaker[] speakerDrafts = [new(), new()];
    private SpeakerInviteMode[] speakerModes = new SpeakerInviteMode[2];
    private bool[] hasImportedProfile = new bool[2];
    private List<string?> speakerLabels = [];
    private List<string?> speakerEmailsSaved = [];
    private List<string> links = [];
    private List<Guid> speakerIds = [];
    private DateTime? createdEventUtc;
    private string createdTitle = string.Empty;
    private Guid createdEventId;
    private string? copiedLink;
    private string? statusMessage;
    private bool isError;
    private bool isSaving;

    private enum SpeakerInviteMode { New, Import, Existing }

    private static string SpeakerModeLabel(SpeakerInviteMode mode) => mode switch
    {
        SpeakerInviteMode.New => "New Speaker",
        SpeakerInviteMode.Import => "Import from Sessionize",
        SpeakerInviteMode.Existing => "Use Existing Speaker",
        _ => throw new ArgumentOutOfRangeException(nameof(mode))
    };

    private void ChangeSpeakerMode(int slot, SpeakerInviteMode mode)
    {
        if (speakerModes[slot] == mode) return;

        speakerModes[slot] = mode;
        selectedSpeakerIds[slot] = null;
        speakerDrafts[slot] = new();
        hasImportedProfile[slot] = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        groups = await db.MeetupGroups.OrderBy(g => g.Name).ToListAsync();
        speakers = await db.Speakers.AsNoTracking()
            .Where(s => s.Name != Speaker.PlaceholderName).OrderBy(s => s.Name).ToListAsync();
        groupId = groups.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private void ApplyProfile(int slot, (SessionizeProfile Profile, SessionizeProfileFields Fields) result)
    {
        var speaker = new Speaker
        {
            Email = speakerDrafts[slot].Email,
            Pronouns = speakerDrafts[slot].Pronouns
        };
        SessionizeSpeakerMapper.ApplyProfile(speaker, result.Profile, result.Fields);
        speakerDrafts[slot] = speaker;
        hasImportedProfile[slot] = true;
    }

    private async Task CreateInviteAsync()
    {
        if (groupId == Guid.Empty)
        {
            statusMessage = "Please create a meetup group first.";
            isError = true;
            return;
        }

        for (var i = 0; i < speakerCount; i++)
        {
            if (speakerModes[i] == SpeakerInviteMode.Existing && selectedSpeakerIds[i] == null)
            {
                statusMessage = $"Select an existing speaker for Speaker {i + 1}.";
                isError = true;
                return;
            }
            if (speakerModes[i] == SpeakerInviteMode.Import && !hasImportedProfile[i])
            {
                statusMessage = $"Choose a Sessionize profile for Speaker {i + 1}, or switch to New Speaker.";
                isError = true;
                return;
            }
        }

        try
        {
            isSaving = true;
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var group = groups.First(g => g.Id == groupId);

            var evt = new MeetupEvent
            {
                MeetupGroupId = groupId,
                Title = EventTitles.Placeholder(group.Name, localEventDateTime),
                EventDateTimeUtc = localEventDateTime.ToUniversalTime(),
                Format = format,
                VenueName = format == EventFormat.Online ? null : venueName,
                LocationOrPlatform = location,
                Status = EventStatus.Draft
            };
            evt.ShortBitlyUrl = ShortUrl.ForEvent(group.ShortUrlStem, evt.EventDateTimeUtc);

            var sessions = new List<EventSpeakerSession>();
            var invitedSpeakers = new List<Speaker>();
            for (var i = 0; i < speakerCount; i++)
            {
                Speaker speaker;
                if (selectedSpeakerIds[i] is { } selectedId)
                {
                    speaker = await db.Speakers.FindAsync(selectedId)
                        ?? throw new InvalidOperationException("The selected speaker no longer exists. Reload the page and select another speaker.");
                }
                else
                {
                    speaker = speakerDrafts[i];
                    speaker.Name = string.IsNullOrWhiteSpace(speaker.Name) ? Speaker.PlaceholderName : speaker.Name.Trim();
                    speaker.Email = string.IsNullOrWhiteSpace(speaker.Email) ? null : speaker.Email.Trim();
                    db.Speakers.Add(speaker);
                }
                invitedSpeakers.Add(speaker);
                var session = new EventSpeakerSession { MeetupEventId = evt.Id, SpeakerId = speaker.Id, OrderIndex = i };
                evt.Sessions.Add(session);
                sessions.Add(session);
            }
            db.MeetupEvents.Add(evt);
            await db.SaveChangesAsync();

            var baseUrl = NavManager.BaseUri.TrimEnd('/');
            var urls = new List<string>();
            foreach (var session in sessions)
            {
                var (rawToken, _) = await MagicLinkService.CreateTokenAsync(session.SpeakerId, session.Id);
                urls.Add($"{baseUrl}/speaker/submit/{rawToken}");
            }

            links = urls;
            speakerIds = sessions.Select(s => s.SpeakerId).ToList();
            speakerLabels = invitedSpeakers.Select(s => s.IsPlaceholder ? null : s.Name).ToList();
            speakerEmailsSaved = invitedSpeakers.Select(s => s.Email).ToList();
            createdEventUtc = evt.EventDateTimeUtc;
            createdTitle = evt.Title;
            createdEventId = evt.Id;
            statusMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create quick invite.");
            statusMessage = $"Failed to create invite: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("meetupOrganiser.copyText", text))
            {
                copiedLink = text;
                statusMessage = null;
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Clipboard copy failed.");
        }

        statusMessage = "Couldn't copy automatically. Select the link and press Ctrl+C.";
        isError = true;
    }

    private async Task SelectAllAsync() => await JS.InvokeVoidAsync("meetupOrganiser.selectFocused");
}
