@page "/events"
@attribute [Authorize]
@using MeetupOrganiser.Core.DTOs
@using MeetupOrganiser.Core.Entities
@using MeetupOrganiser.Core.Services
@using MeetupOrganiser.Core.Interfaces
@using MeetupOrganiser.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IMeetupService MeetupService
@inject NavigationManager NavManager
@inject ILogger<Events> Logger

<PageTitle>Meetup Events - Meetup Organiser</PageTitle>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Meetup Events</h1>
            <p class="text-secondary mb-0">Create, schedule, clone, and manage community meetup events.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger" @onclick="SyncPastMeetupEventsAsync" disabled="@(!Guid.TryParse(selectedGroupId, out _) || isSyncingMeetup || pendingMeetupImport != null)">
                @if (isSyncingMeetup)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Loading...</span>
                }
                else
                {
                    <i class="bi bi-cloud-download me-1"></i>
                    <span>Sync Past Meetup Events</span>
                }
            </button>
            <a href="/events/invite" class="btn btn-outline-primary">
                <i class="bi bi-send me-1"></i> Quick Invite
            </a>
            <a href="/events/new" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> New Event
            </a>
        </div>
    </div>

    @if (statusMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@statusMessage</div>
    }

    @if (pendingMeetupImport is { } pendingImport)
    {
        <div class="card border-0 shadow-sm p-3 mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="h5 fw-bold mb-1">Review past Meetup events</h2>
                    <p class="text-secondary mb-3">
                        @pendingImport.Events.Count event(s) found. Add a matching Sessionize profile to any speaker before importing.
                        Existing Meetup events will be skipped.
                    </p>
                </div>
                <button type="button" class="btn-close" aria-label="Cancel import" @onclick="CancelMeetupImport" disabled="@isSyncingMeetup"></button>
            </div>

            <div class="row g-3 mb-3">
                @foreach (var importedEvent in pendingImport.Events)
                {
                    <div class="col-12 col-lg-6" @key="importedEvent.MeetupEventId">
                        <div class="card h-100 border">
                            @if (!string.IsNullOrWhiteSpace(importedEvent.ImageUrl))
                            {
                                <img src="@importedEvent.ImageUrl" alt="" class="card-img-top" loading="lazy" style="max-height: 200px; object-fit: cover;" />
                            }
                            <div class="card-body">
                                <h3 class="h6 fw-bold mb-1">@importedEvent.Title</h3>
                                <div class="small text-secondary mb-2">
                                    <i class="bi bi-calendar-event me-1"></i>@importedEvent.EventDateTimeUtc.ToString("ddd d MMM yyyy, HH:mm") UTC
                                    @if (!string.IsNullOrWhiteSpace(importedEvent.Location))
                                    {
                                        <span class="ms-2"><i class="bi bi-geo-alt me-1"></i>@importedEvent.Location</span>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold" for="@($"meetup-title-{importedEvent.MeetupEventId}")">Title</label>
                                    <div class="input-group">
                                        <input id="@($"meetup-title-{importedEvent.MeetupEventId}")" class="form-control" value="@importedEvent.Title" readonly />
                                        <button type="button" class="btn btn-outline-primary" @onclick="() => CopyMeetupTextAsync(importedEvent.Title, nameof(importedEvent.Title), importedEvent.MeetupEventId)">
                                            <i class="bi bi-clipboard me-1"></i> Copy
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold" for="@($"meetup-description-{importedEvent.MeetupEventId}")">Meetup details</label>
                                    <div class="input-group">
                                        <textarea id="@($"meetup-description-{importedEvent.MeetupEventId}")" class="form-control" rows="8" readonly>@importedEvent.Description</textarea>
                                        <button type="button" class="btn btn-outline-primary" @onclick="() => CopyMeetupTextAsync(importedEvent.Description ?? string.Empty, nameof(importedEvent.Description), importedEvent.MeetupEventId)">
                                            <i class="bi bi-clipboard me-1"></i> Copy
                                        </button>
                                    </div>
                                </div>

                                @foreach (var importedSpeaker in importedEvent.Speakers.Where(item => !string.IsNullOrWhiteSpace(item.Name)))
                                {
                                    var speaker = importSpeakers.FirstOrDefault(item => string.Equals(item.Name, importedSpeaker.Name.Trim(), StringComparison.OrdinalIgnoreCase));
                                    if (speaker is null) continue;
                                    var isApplied = selectedSessionizeProfiles.ContainsKey(speaker.Name);
                                    var useMeetup = meetupDetailsSpeakers.Contains(speaker.Name);
                                    <div class="border-top pt-2 mt-2" @key="@($"{importedEvent.MeetupEventId}:{speaker.Name}")">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="fw-semibold">@speaker.Name</span>
                                            @if (isApplied)
                                            {
                                                <span class="badge text-bg-success">Profile created</span>
                                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => UseMeetupSpeakerDetails(speaker)">Use Meetup details instead</button>
                                            }
                                            else if (useMeetup)
                                            {
                                                <span class="badge text-bg-secondary">Using Meetup details</span>
                                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => FindOnSessionize(speaker)">Find on Sessionize</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => UseMeetupDetailsOnly(speaker)">Use Meetup details instead</button>
                                            }
                                        </div>
                                        @if (!isApplied && !useMeetup)
                                        {
                                            <SessionizeProfileLookup @key="speaker.Name"
                                                                     InitialQuery="@speaker.Name"
                                                                     Current="speaker"
                                                                     OnApply="result => ApplyImportedSpeakerProfileAsync(speaker, result)" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" @onclick="ImportPendingMeetupEventsAsync" disabled="@isSyncingMeetup">
                    @if (isSyncingMeetup)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Importing...</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-download me-1"></i>
                        <span>Import events</span>
                    }
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelMeetupImport" disabled="@isSyncingMeetup">Cancel</button>
            </div>
        </div>
    }

    <!-- Filter & Search Controls -->
    <div class="card border-0 shadow-sm p-3 mb-4">
        <div class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search events by title or speaker..." @bind="searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select" @bind="selectedGroupId">
                    <option value="">All Groups</option>
                    @if (groups != null)
                    {
                        @foreach (var g in groups)
                        {
                            <option value="@g.Id.ToString()">@g.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedStatus">
                    <option value="">All Statuses</option>
                    <option value="Draft">Draft</option>
                    <option value="Scheduled">Scheduled</option>
                    <option value="Published">Published</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
        </div>
    </div>

    @if (filteredEvents == null)
    {
        @if (statusMessage == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">The event list could not be loaded.</div>
        }
    }
    else if (!filteredEvents.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-calendar-event text-secondary display-4 mb-3"></i>
            <h4 class="fw-bold">No Events Found</h4>
            <p class="text-secondary">Get started by creating your next meetup event.</p>
            <div>
                <a href="/events/new" class="btn btn-primary">Create Event</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date &amp; Time</th>
                            <th>Event Details</th>
                            <th>Group</th>
                            <th>Speaker(s)</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in filteredEvents)
                        {
                            <tr>
                                <td style="min-width: 140px;">
                                    <div class="fw-bold">@evt.EventDateTimeUtc.ToString("MMM dd, yyyy")</div>
                                    <div class="small text-secondary">@evt.EventDateTimeUtc.ToString("HH:mm UTC")</div>
                                    <div class="badge bg-light text-secondary border mt-1">@evt.DurationMinutes min</div>
                                </td>
                                <td>
                                    <div class="fw-bold fs-6"><a href="/events/edit/@evt.Id" class="text-decoration-none text-reset" title="Edit event">@evt.Title</a></div>
                                    <div class="small text-secondary">
                                        <i class="bi bi-geo-alt me-1"></i>@(evt.LocationOrPlatform ?? "Zoom")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(evt.ShortBitlyUrl))
                                    {
                                        <div class="small text-primary font-monospace">@evt.ShortBitlyUrl</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        @(evt.MeetupGroup?.Name ?? ".NET Notts")
                                    </span>
                                </td>
                                <td>
                                    @if (evt.Sessions.Any())
                                    {
                                        @foreach (var s in evt.Sessions)
                                        {
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                @if (s.Speaker != null)
                                                {
                                                    <a href="/speakers?edit=@s.Speaker.Id" title="Edit @s.Speaker.Name">
                                                        @if (!string.IsNullOrWhiteSpace(s.Speaker.PhotoBlobUrl))
                                                        {
                                                            <img src="@s.Speaker.PhotoBlobUrl" alt="@s.Speaker.Name" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-person-fill text-primary"></i>
                                                        }
                                                    </a>
                                                    <span><a href="/speakers?edit=@s.Speaker.Id" class="fw-bold text-reset text-decoration-none" title="Edit @s.Speaker.Name">@s.Speaker.Name</a>: @s.TalkTitle</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person-fill text-primary"></i>
                                                    <span><strong>Speaker</strong>: @s.TalkTitle</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No speakers assigned</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadge(evt.Status)">@evt.Status</span>
                                    @if (evt.Sessions.Any(s => s.Speaker?.IsPlaceholder == true) || (evt.Status == EventStatus.Draft && MeetupOrganiser.Core.Services.EventTitles.IsPlaceholder(evt.Title)))
                                    {
                                        <span class="badge text-bg-warning ms-1">Awaiting speaker</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/events/edit/@evt.Id?tab=assets" class="btn btn-outline-primary" title="Slide Deck & Social Images">
                                            <i class="bi bi-file-earmark-slides me-1"></i> Assets
                                        </a>
                                        <a href="/events/edit/@evt.Id" class="btn btn-outline-secondary" title="Edit Event">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-outline-info" title="Clone Event" @onclick="() => CloneEventAsync(evt)">
                                            <i class="bi bi-copy"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Delete" @onclick="() => DeleteEventAsync(evt)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private ConfirmDialog? confirmDialog;
    private List<MeetupEvent>? allEvents;
    private List<MeetupGroup>? groups;
    private string searchQuery = string.Empty;
    private string selectedGroupId = string.Empty;
    private string selectedStatus = string.Empty;
    private string? statusMessage;
    private bool isError;
    private bool isSyncingMeetup;
    private MeetupEventImportResult? pendingMeetupImport;
    private Guid? pendingMeetupGroupId;
    private List<Speaker> importSpeakers = [];
    private readonly Dictionary<string, SelectedSessionizeProfile> selectedSessionizeProfiles = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> meetupDetailsSpeakers = new(StringComparer.OrdinalIgnoreCase);

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private IEnumerable<MeetupEvent>? filteredEvents => allEvents?
        .Where(e => (string.IsNullOrWhiteSpace(searchQuery) ||
                     e.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     e.Sessions.Any(s => s.Speaker != null && s.Speaker.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))) &&
                    (string.IsNullOrWhiteSpace(selectedGroupId) || e.MeetupGroupId.ToString() == selectedGroupId) &&
                    (string.IsNullOrWhiteSpace(selectedStatus) || e.Status.ToString() == selectedStatus));

    private async Task CopyMeetupTextAsync(string text, string field, string meetupEventId)
    {
        field = field == nameof(MeetupEventImportDto.Title) ? "title" : "details";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            statusMessage = $"Meetup {field} copied to the clipboard.";
            isError = false;
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Failed to copy Meetup {Field} for event {MeetupEventId}.", field, meetupEventId);
            statusMessage = $"Unable to copy Meetup {field}. Please check your browser clipboard permissions.";
            isError = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            groups = await dbContext.MeetupGroups.OrderBy(g => g.Name).ToListAsync();
            await LoadEventsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the event list.");
            statusMessage = "Unable to load events. The error has been logged.";
            isError = true;
        }
    }

    private async Task LoadEventsAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        allEvents = await dbContext.MeetupEvents
            .Include(e => e.MeetupGroup)
            .Include(e => e.Sessions)
                .ThenInclude(s => s.Speaker)
            .OrderByDescending(e => e.EventDateTimeUtc)
            .ToListAsync();
    }

    private async Task CloneEventAsync(MeetupEvent evt)
    {
        try
        {
            var cloned = new MeetupEvent
            {
                Id = Guid.NewGuid(),
                MeetupGroupId = evt.MeetupGroupId,
                Title = $"{evt.Title} (Copy)",
                Description = evt.Description,
                EventDateTimeUtc = evt.EventDateTimeUtc.AddMonths(1),
                DurationMinutes = evt.DurationMinutes,
                LocationOrPlatform = evt.LocationOrPlatform,
                Status = EventStatus.Draft,
                CreatedAtUtc = DateTime.UtcNow,
                UpdatedAtUtc = DateTime.UtcNow
            };

            foreach (var s in evt.Sessions)
            {
                cloned.Sessions.Add(new EventSpeakerSession
                {
                    Id = Guid.NewGuid(),
                    MeetupEventId = cloned.Id,
                    SpeakerId = s.SpeakerId,
                    TalkTitle = s.TalkTitle,
                    TalkDescription = s.TalkDescription,
                    OrderIndex = s.OrderIndex
                });
            }

            await using (var dbContext = await DbContextFactory.CreateDbContextAsync())
            {
                await dbContext.MeetupEvents.AddAsync(cloned);
                await dbContext.SaveChangesAsync();
            }

            await LoadEventsAsync();
            statusMessage = "Event cloned.";
            isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clone event.");
            statusMessage = "Unable to clone this event. The error has been logged.";
            isError = true;
        }
    }

    private async Task DeleteEventAsync(MeetupEvent evt)
    {
        if (!await confirmDialog!.ShowAsync($"Delete the event \"{evt.Title}\"? This cannot be undone.", "Delete event?")) return;

        try
        {
            await using (var dbContext = await DbContextFactory.CreateDbContextAsync())
            {
                var eventToDelete = await dbContext.MeetupEvents.FindAsync(evt.Id);
                if (eventToDelete == null) return;

                dbContext.MeetupEvents.Remove(eventToDelete);
                await dbContext.SaveChangesAsync();
            }

            await LoadEventsAsync();
            statusMessage = "Event deleted.";
            isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete event {EventId}.", evt.Id);
            statusMessage = "Unable to delete this event. The error has been logged.";
            isError = true;
        }
    }

    private async Task SyncPastMeetupEventsAsync()
    {
        if (!Guid.TryParse(selectedGroupId, out var groupId))
        {
            statusMessage = "Select a Meetup group before syncing its past events.";
            isError = true;
            return;
        }

        var group = groups?.FirstOrDefault(item => item.Id == groupId);
        if (group == null)
        {
            statusMessage = "The selected Meetup group could not be found.";
            isError = true;
            return;
        }

        try
        {
            isSyncingMeetup = true;
            statusMessage = null;
            var import = await MeetupService.ImportPastEventsAsync(group.MeetupUrlName ?? "dotnetnotts");
            if (!import.Success)
            {
                statusMessage = import.ErrorMessage ?? "Meetup could not return past events.";
                isError = true;
                return;
            }

            pendingMeetupImport = import;
            pendingMeetupGroupId = groupId;
            selectedSessionizeProfiles.Clear();
            meetupDetailsSpeakers.Clear();
            importSpeakers = import.Events
                .SelectMany(item => item.Speakers)
                .Where(item => !string.IsNullOrWhiteSpace(item.Name))
                .GroupBy(item => item.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                .Select(group => new Speaker
                {
                    Name = group.Key,
                    Bio = group.Select(item => item.Bio).FirstOrDefault(bio => !string.IsNullOrWhiteSpace(bio))
                })
                .ToList();
            statusMessage = null;
            isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to sync past Meetup events for group {GroupId}.", groupId);
            statusMessage = "Unable to sync past Meetup events. The error has been logged.";
            isError = true;
        }
        finally
        {
            isSyncingMeetup = false;
        }
    }

    private Task ApplyImportedSpeakerProfileAsync(
        Speaker speaker,
        (SessionizeProfile Profile, SessionizeProfileFields Fields) selection)
    {
        selectedSessionizeProfiles[speaker.Name] = new SelectedSessionizeProfile(selection.Profile, selection.Fields, speaker.Pronouns);
        speaker.Pronouns = null;
        return Task.CompletedTask;
    }

    private void UseMeetupSpeakerDetails(Speaker speaker)
    {
        selectedSessionizeProfiles.Remove(speaker.Name);
        speaker.Pronouns = null;
        meetupDetailsSpeakers.Add(speaker.Name);
    }

    private void UseMeetupDetailsOnly(Speaker speaker) => meetupDetailsSpeakers.Add(speaker.Name);

    private void FindOnSessionize(Speaker speaker) => meetupDetailsSpeakers.Remove(speaker.Name);

    private static string AbridgeDescription(string? description, int maxLength = 220)
    {
        if (string.IsNullOrWhiteSpace(description)) return string.Empty;
        var text = System.Text.RegularExpressions.Regex.Replace(description, @"[*_#>`]+|\[([^\]]*)\]\([^)]*\)", "$1");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
    }

    private async Task ImportPendingMeetupEventsAsync()
    {
        if (pendingMeetupImport is not { Success: true } import || pendingMeetupGroupId is not { } groupId)
        {
            statusMessage = "Load past Meetup events before importing.";
            isError = true;
            return;
        }

        try
        {
            isSyncingMeetup = true;
            statusMessage = null;
            var importedEventCount = 0;
            var importedSpeakerCount = 0;
            var skippedEventCount = 0;
            await using (var dbContext = await DbContextFactory.CreateDbContextAsync())
            {
                var externalEventIds = import.Events.Select(item => item.MeetupEventId).ToList();
                var knownEventIds = await dbContext.MeetupEvents
                    .Where(item => item.MeetupEventId != null && externalEventIds.Contains(item.MeetupEventId))
                    .Select(item => item.MeetupEventId!)
                    .ToListAsync();
                var knownEventIdSet = knownEventIds.ToHashSet(StringComparer.Ordinal);
                var knownSpeakers = await dbContext.Speakers.ToListAsync();

                foreach (var importedEvent in import.Events)
                {
                    if (!knownEventIdSet.Add(importedEvent.MeetupEventId))
                    {
                        skippedEventCount++;
                        continue;
                    }

                    var meetupEvent = new MeetupEvent
                    {
                        Id = Guid.NewGuid(),
                        MeetupGroupId = groupId,
                        Title = importedEvent.Title,
                        Description = importedEvent.Description,
                        EventDateTimeUtc = importedEvent.EventDateTimeUtc,
                        DurationMinutes = importedEvent.DurationMinutes,
                        LocationOrPlatform = importedEvent.Location,
                        MeetupEventId = importedEvent.MeetupEventId,
                        MeetupEventUrl = importedEvent.EventUrl,
                        Status = EventStatus.Completed,
                        CreatedAtUtc = DateTime.UtcNow,
                        UpdatedAtUtc = DateTime.UtcNow
                    };

                    for (var index = 0; index < importedEvent.Speakers.Count; index++)
                    {
                        var importedSpeaker = importedEvent.Speakers[index];
                        var speaker = knownSpeakers.FirstOrDefault(existing =>
                            string.Equals(existing.Name, importedSpeaker.Name, StringComparison.OrdinalIgnoreCase));
                        if (speaker == null)
                        {
                            speaker = new Speaker
                            {
                                Id = Guid.NewGuid(),
                                Name = importedSpeaker.Name,
                                Bio = importedSpeaker.Bio,
                                CreatedAtUtc = DateTime.UtcNow,
                                UpdatedAtUtc = DateTime.UtcNow
                            };
                            SpeakerBio.EnsureThirdPerson(speaker);
                            await dbContext.Speakers.AddAsync(speaker);
                            knownSpeakers.Add(speaker);
                            importedSpeakerCount++;
                        }
                        else if (string.IsNullOrWhiteSpace(speaker.Bio) && !string.IsNullOrWhiteSpace(importedSpeaker.Bio))
                        {
                            speaker.Bio = importedSpeaker.Bio;
                            SpeakerBio.EnsureThirdPerson(speaker, force: true);
                            speaker.UpdatedAtUtc = DateTime.UtcNow;
                        }

                        if (selectedSessionizeProfiles.TryGetValue(importedSpeaker.Name.Trim(), out var selectedProfile))
                        {
                            SessionizeSpeakerMapper.ApplyProfile(speaker, selectedProfile.Profile, selectedProfile.Fields);
                            speaker.Pronouns = selectedProfile.Pronouns;
                            speaker.UpdatedAtUtc = DateTime.UtcNow;
                        }

                        meetupEvent.Sessions.Add(new EventSpeakerSession
                        {
                            Id = Guid.NewGuid(),
                            MeetupEventId = meetupEvent.Id,
                            SpeakerId = speaker.Id,
                            TalkTitle = importedSpeaker.TalkTitle ?? importedEvent.Title,
                            TalkDescription = null,
                            OrderIndex = index + 1
                        });
                    }

                    await dbContext.MeetupEvents.AddAsync(meetupEvent);
                    importedEventCount++;
                }

                await dbContext.SaveChangesAsync();
            }

            await LoadEventsAsync();
            pendingMeetupImport = null;
            pendingMeetupGroupId = null;
            importSpeakers = [];
            selectedSessionizeProfiles.Clear();
            meetupDetailsSpeakers.Clear();
            statusMessage = $"Synced {importedEventCount} past events and added {importedSpeakerCount} speaker profiles. "
                + $"{skippedEventCount} events were already in the app.";
            isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import past Meetup events for group {GroupId}.", groupId);
            statusMessage = "Unable to import past Meetup events. The error has been logged.";
            isError = true;
        }
        finally
        {
            isSyncingMeetup = false;
        }
    }

    private void CancelMeetupImport()
    {
        pendingMeetupImport = null;
        pendingMeetupGroupId = null;
        importSpeakers = [];
        selectedSessionizeProfiles.Clear();
        meetupDetailsSpeakers.Clear();
        statusMessage = null;
        isError = false;
    }

    private sealed record SelectedSessionizeProfile(SessionizeProfile Profile, SessionizeProfileFields Fields, string? Pronouns);

    private static string GetStatusBadge(EventStatus status) => status switch
    {
        EventStatus.Published => "bg-success text-white",
        EventStatus.Scheduled => "bg-primary text-white",
        EventStatus.Draft => "bg-warning text-dark",
        EventStatus.Completed => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };
}
